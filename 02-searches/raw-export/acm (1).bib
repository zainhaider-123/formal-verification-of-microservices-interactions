@article{10.1145/3720418,
author = {Wang, Hanzhang and Peng, Wei and Wang, Wenwen and Lu, Yunping and Yew, Pen-Chung and Zhang, Weihua},
title = {JavART: A Lightweight Rule-Based JIT Compiler using Translation Rules Extracted from a Learning Approach},
year = {2025},
issue_date = {April 2025},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {9},
number = {OOPSLA1},
url = {https://doi.org/10.1145/3720418},
doi = {10.1145/3720418},
abstract = {The balance between the compilation/optimization time and the produced code quality is very important for Just-In-Time (JIT) compilation. Time-consuming optimizations can cause delayed deployment of the optimized code, and thus more execution time needs to be spent either in the interpretation or less optimized code, leading to a performance drag. Such a performance drag can be detrimental to mobile and client-side devices such as those running Android, where applications are often shorting-running, frequently restarted and updated. To tackle this issue, this paper presents a lightweight learning-based, rule-guided dynamic compilation approach to generate good-quality native code directly without the need to go through the interpretive phase and the first-level optimization at runtime. Different from existing JIT compilers, the compilation process is driven by translation rules, which are automatically learned offline by taking advantage of existing JIT compilers. We have implemented a prototype of our approach based on Android 14 to demonstrate the feasibility and effectiveness of such a lightweight rule-based approach using several real-world applications. Results show that, compared to the default mode running with the interpreter and two tiers of JIT compilers, our prototype can achieve a 1.23{\texttimes} speedup on average. Our proposed compilation approach can also generate native code 5.5X faster than the existing first-tier JIT compiler in Android, with the generated code running 6% faster. We also implement and evaluate our approach on a client-side system running Hotspot JVM, and the results show an average of 1.20{\texttimes} speedup.},
journal = {Proc. ACM Program. Lang.},
month = apr,
articleno = {84},
numpages = {30},
keywords = {Just-in-time Compilation, Interpretation, Android Runtime, JVM}
}

@inbook{10.1145/3803437.3806092,
author = {Yu, Guangba and Wang, Yilun and Lyu, Michael R.},
title = {Freezing the Crime Scene: A State Snapshot Paradigm for Reproducible Agentic SRE Evaluation},
year = {2026},
isbn = {9798400726361},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803437.3806092},
abstract = {While Large Language Models (LLMs) are transforming Site Reliability Engineering (SRE), current evaluation frameworks face an inherent tension between ecological validity and reproducibility. Live cluster benchmarks suffer from environmental stochasticity, while static datasets lack the interactivity required for agentic reasoning. To resolve this, we propose the state snapshot paradigm, a methodological shift that decouples operational state from runtime execution to create deterministic digital twins. This infrastructure enables rigorous process-centric evaluation, revealing critical insights that outcome-based metrics overlook. Ultimately, this paradigm serves not merely as a benchmark, but as an evolutionary engine for training the next generation of trustworthy Agentic SREs.},
booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
pages = {1733–1737},
numpages = {5}
}

