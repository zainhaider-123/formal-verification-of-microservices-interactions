@inproceedings{10.1145/3691621.3694937,
author = {Park, Jiwon and Laddad, Shadaj and Bali, Dev and Zhang, Wen and Shenker, Scott and Zaharia, Matei},
title = {Everything Everywhere All At Once: Efficient Cross-Service Program Analysis with OverSeer},
year = {2024},
isbn = {9798400712494},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3691621.3694937},
doi = {10.1145/3691621.3694937},
abstract = {Microservice applications often encounter failures due to cross-service assumptions that are challenging to reason about, such as timing, data formats, and semantic changes. These problems can arise as individual teams update and roll back their services independently, causing implicit assumptions about service interaction to become invalid. To prevent such issues, teams must ensure the validity of service interactions across all services and all combinations of versions that may coexist in production, which is both difficult and error-prone to do manually. In this paper, we argue for richer specifications and automated analysis of properties in cross-service programs. We present OverSeer, a framework for cross-service program analysis that can check a wide range of useful program properties efficiently across possible combinations of service versions. OverSeer avoids the combinatorial explosion caused by versioning of services by leveraging the lattice structure of many program properties, including properties about types, timing, and effects. We evaluate OverSeer's scalability on synthetic benchmarks and show it can analyze large systems with 4,000 services and 16,000 endpoints in less than a second.},
booktitle = {Proceedings of the 39th IEEE/ACM International Conference on Automated Software Engineering Workshops},
pages = {82–87},
numpages = {6},
location = {Sacramento, CA, USA},
series = {ASEW '24}
}

@inproceedings{10.1145/3769694.3771161,
author = {Yang, Guang and Trinh, Peter and Serikyaku, Amuru and Nkemla, Alma and Tatchim, Edward and Sharaf, Osman},
title = {Blockchain-Based Decentralized Domain Name System},
year = {2025},
isbn = {9798400722400},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3769694.3771161},
doi = {10.1145/3769694.3771161},
abstract = {The Domain Name System (DNS) is critical yet vulnerable to poisoning, censorship, and centralized failures. Recent attacks (e.g., StormBamboo) highlight the need for resilient alternatives. We present a blockchain-powered, censorship-resistant DNS architecture that: (i) employs a purpose-built Proof-of-Work chain optimized for DNS workloads and decentralized participation, (ii) integrates IPFS for distributed storage, and (iii) provides end-to-end verification under a Never Trust, Always Verify zero-trust model. Our implementation propagates domain updates in 15 seconds, supports 20 standard DNS record types, and offers perpetual free.ddns domains. A geographically distributed deployment demonstrates practical scalability and robustness against manipulation. Evaluation shows up to 1,000+ tx/s for minimal transactions and 250+ tx/s for regular operations, with sub-second query latency via intelligent caching.},
booktitle = {Proceedings of the 26th ACM Annual Conference on Cybersecurity &amp; Information Technology Education},
pages = {267–274},
numpages = {8},
keywords = {Blockchain, Decentralized DNS, Proof of Work, UTXO Model, Anti-Censorship, Cryptographic Verification, IPFS, Domain Name System},
location = {Sacramento, California, USA},
series = {SIGCITE '25}
}

