@proceedings{10.1145/3793654,
editor = {Breno Miranda, Ana Paiva, Markus Borg, Andy Zaidman and Morena Barboni},
title = {AST '26: Proceedings of the 7th ACM/IEEE International Conference on Automation of Software Test},
year = {2026},
isbn = {9798400724763},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The special theme of AST 2026 is "Adapting test automation to the AI era including sustainability and emerging challenges". We are seeing that the AI era is causing a transformative shift in test automation, revolutionizing traditional approaches and enhancing efficiency, accuracy, and adaptability. This integration of AI and machine learning introduces intelligent test case generation, self-healing test scripts, and predictive analytics. These advances have the potential to significantly reduce testing time, while improving overall software quality. The role of testers will evolve from test script writers to strategic overseers, focusing on test design, data and quality interpretation, and critical problem-solving. As AI takes on repetitive tasks, it allows for more comprehensive test coverage, including the identification of edge cases that human testers might overlook. The future of test automation lies in agent-like testing systems that learn continuously, adapt to changes, and provide deeper insights into software quality, ultimately leading to faster, more reliable software delivery in an increasingly complex digital landscape.},
location = {Rio de Janeiro, Brazil}
}

@inproceedings{10.1145/3641399.3641410,
author = {Kumar, Mrityunjay and Choppella, Venkatesh},
title = {Enhancing MVC architecture pattern description using its System of Systems model},
year = {2024},
isbn = {9798400717673},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3641399.3641410},
doi = {10.1145/3641399.3641410},
abstract = {When novice engineers (fresh or recent graduates with little industry experience) join a SaaS (Software-as-a-Service) product company, they are tasked with comprehending the product, especially its behavior and dynamics. We believe that they can comprehend more effectively if they know and understand the architecture patterns used in the product. Are the current architecture pattern descriptions of high quality? Do they fit the needs of novice engineers? We evaluated the pattern descriptions of Model-View-Controller (MVC) (a popular and important architecture pattern for cloud systems) from a quality and fitment perspective and found gaps. To address these gaps, we have built a System of Systems (SoS) model of MVC that uses a transition systems vocabulary and a set-theoretic notation. In the paper, we show that this SoS model provides a rich set of information about the behavior and dynamics of the MVC components and their interactions. The model bridges the gaps in the MVC pattern description. One of the contributions of the paper is to provide criteria to evaluate the pattern descriptions for quality and fitment for novice engineers. The paper proposes that we augment the benchmark pattern description of MVC with an SoS model. The paper also demonstrates a general approach to building SoS models for architecture patterns and recommends creating a catalog of SoS models for SaaS architecture patterns. We believe such a catalog will significantly help novice engineers in comprehension and other software engineering activities.},
booktitle = {Proceedings of the 17th Innovations in Software Engineering Conference},
articleno = {8},
numpages = {11},
keywords = {Model-View-Controller (MVC), architecture pattern, novice engineers, system of systems, transition systems},
location = {Bangalore, India},
series = {ISEC '24}
}

@inproceedings{10.1145/3766557.3766580,
author = {Wang, Jiong and Fan, Ping and Zhang, Hua},
title = {Innovative Exploration of the “Four-Dimensional Linkage” Teaching System of Network Security Based on Interdisciplinary Research},
year = {2025},
isbn = {9798400721168},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3766557.3766580},
doi = {10.1145/3766557.3766580},
abstract = {In response to the problems of subject separation and theoretical practice disconnection in network security education, a “four-dimensional linkage” teaching system based on interdisciplinary network security has been constructed. Through knowledge graph technology, multidisciplinary knowledge integration is achieved, and digital twin technology is used to build a practical environment that integrates theory and practice, forming a “theory practice innovation evaluation” linkage mechanism. A comparative experiment was conducted on 60 undergraduate students, with the experimental group using a four-dimensional linkage system and the control group using a traditional mode. Build a knowledge system covering cryptography, network protocols, system security, etc., and develop practical training modules such as attack and defense exercises and system reinforcement. The experimental results showed that the experimental group was significantly better than the control group in terms of knowledge mastery, practical skills, and innovation ability (P&lt;0.001), verifying the effectiveness of the teaching system.},
booktitle = {Proceedings of the 2025 International Conference on Educational Technology and Artificial Intelligence},
pages = {128–133},
numpages = {6},
keywords = {Digital Twin, Four-Dimensional Linkage, Interdisciplinary, Knowledge Graph, Network Security Education},
location = {Wuhan, China},
series = {ETAIC '25}
}

