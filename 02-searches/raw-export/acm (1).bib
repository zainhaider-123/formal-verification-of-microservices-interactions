@inproceedings{10.1145/3793654.3793750,
author = {de Oliveira, Benedito and Castor, Fernando and Fernandes, Leo and Amorim, Samuel},
title = {Exploring Mocking Techniques for Managing External Dependencies in Service-Based Systems: A Mapping Study},
year = {2026},
isbn = {9798400724763},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3793654.3793750},
doi = {10.1145/3793654.3793750},
abstract = {Service-based systems (SBS) depend on loosely coupled services that interact via standardized protocols, making testing challenging due to external dependencies. Mocking and service virtualization techniques have been proposed to simulate these dependencies and support automated testing, yet existing research lacks a unified synthesis of their approaches, effectiveness, and limitations. This systematic mapping study reviews&nbsp;43&nbsp;primary studies from IEEE Xplore, the ACM Digital Library, and Scopus on mock generation for SBS. We provide a structured taxonomy of mocking techniques and classify techniques into modeling and formal specification, contract-based testing, execution-based simulation, test generation, machine learning, and instrumentation. Our findings show that contract and specification-based methods constitute the majority of the papers we have examined, while AI-driven mock generation remains a sparsely-explored topic, tool support for scalable service virtualization is almost non-existent, and benchmark datasets are missing. We also identify cross-cutting aspects addressed by existing studies, including state management, service virtualization, behavior consistency, and reusability. These aspects highlight the challenges of maintaining realistic, reusable, and cost-effective mocks in distributed and evolving service-based systems. Evaluation practices rely mostly on laboratory experiments and prototype demonstrations, with limited industrial validation. Key challenges include scalability, behavioral fidelity, and maintainability, with emerging trends toward dynamic and AI-assisted mock generation.},
booktitle = {Proceedings of the 7th ACM/IEEE International Conference on Automation of Software Test},
pages = {82–92},
numpages = {11},
keywords = {Mocking, service virtualization, automated testing, dependency simulation, software testing, microservices, service-based systems.},
location = {Rio de Janeiro, Brazil},
series = {AST '26}
}

@inproceedings{10.1145/3777884.3797014,
author = {Noferesti, Morteza and Panahandeh, Mahsa and Ezzati-Jivan, Naser},
title = {B-Perf: Black-box Performance Antipattern Detection Using System-level Execution Tracing},
year = {2026},
isbn = {9798400723254},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3777884.3797014},
doi = {10.1145/3777884.3797014},
abstract = {Performance antipatterns capture recurring behaviours that degrade software efficiency. Black-box approaches aim to detect such issues without modifying the application. This paper presents B-Perf, a system-level black-box method that reconstructs execution, memory, and messaging behaviour from kernel-level traces. By analysing scheduling, allocation, and communication events, B-Perf derives workload-dependent behavioural trends and reports antipattern indicators grounded in resource usage and contention. To handle large trace volumes, the approach follows a pipeline of workload generation, event gathering, trace handling, and antipattern inference. We evaluate B-Perf on three representative antipatterns: One Lane Bridge, Empty Semi Trucks, and Excessive Dynamic Allocation, and apply it to traces from real multi-threaded applications. The results show that system-level events are often sufficient to expose bottlenecks linked to resource contention and system-level interactions. A key limitation is that kernel traces provide limited visibility into fine-grained in-process behaviour. When performance issues are driven by internal logic or function-level interactions, B-Perf may capture only indirect symptoms and may not reveal the full root cause. Within this scope, B-Perf provides practical and efficient black-box detection for antipatterns driven by resource interaction and competition.},
booktitle = {Proceedings of the 17th ACM/SPEC International Conference on Performance Engineering},
pages = {96–107},
numpages = {12},
keywords = {software performance antipattern, performance analysis, black-box monitoring, execution tracing, software analysis},
location = {Florence, Italy},
series = {ICPE '26}
}

