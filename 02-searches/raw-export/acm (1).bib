@inproceedings{10.1145/3800973.3801028,
author = {Huang, Ningjiang},
title = {Multimodal Financial Report Generation with Mixture-of-Experts Reasoning and Diffusion-Based Chart Synthesis},
year = {2026},
isbn = {9798400722103},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3800973.3801028},
doi = {10.1145/3800973.3801028},
abstract = {Automated financial report generation requires precise numerical reasoning and consistent data visualization. Current models often struggle to maintain temporal consistency across textual analysis and chart synthesis, leading to hallucinations in sensitive market contexts. We present FinChart-LLM, a sophisticated multimodal framework that integrates a frozen Qwen3-235B Mixture-of-Experts backbone with a modified Stable Diffusion 3.5 architecture. Our approach introduces a Financial Reasoning Chain for iterative multi-hop analysis and a Cross-Modal Alignment Network to bridge semantic gaps between financial text and visual indicators. By dynamically allocating computational budgets through complexity-aware scaling, the system ensures resource efficiency without compromising analytical depth. Experimental results demonstrate that FinChart-LLM outperforms state-of-the-art baselines in financial accuracy scores and temporal consistency indices.},
booktitle = {Proceedings of the 2026 International Conference on Artificial Intelligence and Fintech},
pages = {358–364},
numpages = {7},
keywords = {Financial Analysis, Mixture of Experts, Multimodal Learning, Diffusion Models, Chain of Thought},
location = {Guangzhou, China},
series = {IC-AIF '26}
}

