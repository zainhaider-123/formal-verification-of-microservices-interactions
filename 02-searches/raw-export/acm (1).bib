year = {2023},
publisher = {IBM Corp.},
address = {USA},
abstract = {Cyber-Physical systems (CPS) refer to complex sociotechnical sys-tems that integrate physical, cyber, and social elements to form complete solutions that require the real-time interaction and co-ordination between physical and digital processes. These systems pose unique challenges related to specification, modeling, design, and testing, that go beyond existing Software Engineering concepts, tools, and techniques. The 3𝑟𝑑 workshop on Software Techniques for Engineering Cyber-Physical Systems held within the CASCON conference, focused on the recent developments and research chal-lenges related to designing and implementing infrastructure tech-nologies for large scale data management, cloud performance, smart contracts, remote sensing and digital twins for service-oriented sys-tems. The interested reader can refer to the proceedings of the workshop for delving ito the details of the work presented by the participants},
