@inproceedings{10.1145/3661167.3661191,
author = {Chianese, Raffaele and Beneduce, Leopoldo and Gargiulo, Francesco and Marrone, Stefano and Verde, Laura},
title = {Dealing with clinical outcome and fair cost: the FIDCARE platform},
