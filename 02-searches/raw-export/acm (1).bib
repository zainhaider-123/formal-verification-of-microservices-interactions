@inproceedings{10.1145/3658644.3691371,
author = {Dayama, Pankaj and Pandit, Vinayaka and Patranabis, Sikhar and Singh, Abhishek and Singh, Nitin},
title = {Poster: A Secure Multiparty Computation Platform for Squeaky-Clean Data Rooms},
year = {2024},
isbn = {9798400706363},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3658644.3691371},
doi = {10.1145/3658644.3691371},
abstract = {Modern approaches for multiparty secure collaboration must strike the right balance between rich analytics and requisite data privacy guarantees, especially in the face of new regulations. While cryptographic technologies such as fully homomorphic encryption (FHE) and secure multiparty computation (MPC) provide strong, provable security guarantees as standalone tools, deploying them in practice throws up a myriad of challenges, including usability constraints and lack of precise specification of privacy guarantees. In this work, we propose a novel framework for real-world deployment of cryptographic privacy preserving techniques that achieves the twin goals of practical usability in real-world setting and provable privacy guarantees from users' perspective. To this end, we formalize the notion of a secure computation platform (SCP) for privacy preserving data collaboration, and introduce a model for precise specification of privacy guarantees for multiparty workflows. We then describe abstractions of a set of cryptoprimitives, that are usable by non-experts in cryptography. We present two demo workflows that empirically validate our claims, and serve as potential building blocks for the development of squeaky-clean data rooms with practical performance and privacy guarantees.},
booktitle = {Proceedings of the 2024 on ACM SIGSAC Conference on Computer and Communications Security},
pages = {5069–5071},
numpages = {3},
keywords = {data clean rooms, secure multiparty computation},
location = {Salt Lake City, UT, USA},
series = {CCS '24}
}

@article{10.1145/3861010,
author = {Mothukuri, Viraaji and Parizi, Reza M.},
title = {VibeDApps: Autonomous Agentic AI Development of Decentralized Applications},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3861010},
doi = {10.1145/3861010},
abstract = {The development of blockchain applications demands expertise across smart contracts, backend services, frontend interfaces, and security auditing, a rare combination that creates barriers to entry and constrains innovation. While existing frameworks attempt to address individual aspects of this complexity, they remain fragmented and require manual integration, leaving developers to navigate disconnected tools without end-to-end automation. More critically, the increasing adoption of AI-assisted coding introduces a risk through homogeneous vulnerability patterns, as developers using similar language models replicate security flaws across multiple applications. To address these challenges, we present VibeDApps, a multi-agent architecture that transforms DApp development from a manual, expertise-intensive process into an orchestrated workflow where four specialized agents, Contract, Backend, Frontend, and Audit, collaborate through structured protocols to generate applications from natural language specifications. Unlike approaches where AI serves merely as a coding assistant, our agents operate as autonomous peers, with each maintaining deep domain expertise while coordinating through asynchronous message passing to ensure system-wide coherence. The architecture's central innovation lies in its generation strategy that combines multiple approaches, including template instantiation, pattern composition, and guided synthesis, specifically designed to avoid the homogeneous vulnerabilities that arise when relying on single-model generation. Furthermore, security validation is embedded continuously throughout the development lifecycle rather than relegated to post-development auditing, enabling immediate detection and correction of vulnerabilities as code is generated. Evaluation across 50 DApp specifications spanning DeFi protocols, NFT marketplaces, and DAO systems shows average generation times of four minutes with high success rates for standard patterns. Complex DeFi protocols with circular dependencies are more challenging but can be improved through dependency resolution algorithms. Statistical validation confirms all performance claims with high confidence. This work lays the foundations for democratizing blockchain development, enabling developers without specialized expertise to create secure DApps while meeting the stringent security requirements of financial applications in adversarial environments.},
note = {Just Accepted},
journal = {Distrib. Ledger Technol.},
month = oct,
keywords = {AI Agents, Decentralized Applications, DApps, Automation, Large Language Models (LLMs), Agentic AI}
}

