@inproceedings{10.1145/3664476.3670905,
author = {Pawlicki, Marek and Puchalski, Damian and Szelest, Sebastian and Pawlicka, Aleksandra and Kozik, Rafa{\l} and Chora{\'s}, Micha{\l}},
title = {Introducing a Multi-Perspective xAI Tool for Better Model Explainability},
