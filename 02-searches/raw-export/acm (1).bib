@inproceedings{10.1145/3756907.3756910,
author = {Meiklejohn, Christopher and Van Roy, Peter},
title = {Distributed, Coordination-Free Programming: 10 Years of Progress Since Lasp},
year = {2025},
isbn = {9798400720857},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3756907.3756910},
doi = {10.1145/3756907.3756910},
abstract = {This retrospective reflects on a decade of influence stemming from Lasp, a coordination-free programming model built atop Conflict-Free Replicated Data Types (CRDTs). Designed to simplify distributed programming by prioritizing availability and convergence, Lasp has had a lasting impact across academia and industry. Its coordination-free model inspired a generation of research into program synthesis, semantics verification, and declarative, distributed programming languages. Not only did Lasp live in the lab, it was also validated through large-scale experiments: deployments on over 1,000 AWS nodes during the early era of CRDT exploration when achieving this scale was a challenge. Lasp’s open-source distribution layer that facilitated these experiments, Partisan, saw broader industrial adoption, influencing improvements to the Erlang runtime and formed the inspiration for Filibuster, a fault injection tool adopted in practice for microservice architectures. As the industry shifts toward multi-region deployments, Lasp’s core insight — that coordination can be the exception, not the rule — continues to shape how we build reliable, scalable systems today.},
booktitle = {Proceedings of the 27th International Symposium on Principles and Practice of Declarative Programming},
articleno = {3},
numpages = {3},
location = {Rende, Italy},
series = {PPDP '25}
}

