address = {New York, NY, USA},
abstract = {It is our great pleasure to welcome you to the 16th edition of the ACM Cloud Computing Security Workshop. CCSW is the world's premier forum bringing together researchers and practitioners in all security aspects of cloud-centric and outsourced computing including:CCSW especially encourages novel paradigms and controversial ideas, even when they are not on the above list. The workshop has historically acted as a fertile ground for creative debate and interaction in cloud security and has had a significant impact in our research community. This year marked the 16th anniversary of CCSW, and we strive to continue this tradition.},
location = {Taipei, Taiwan}
