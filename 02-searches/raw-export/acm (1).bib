@inproceedings{10.1145/3788853.3803091,
author = {Yang, Xiao and Sha, Mo and Li, Yiran and Zhong, Suyang and Wang, Sheng and Zhou, Fangyuan and Li, Feifei},
title = {SQLens: Continuous Code-to-SQL Visibility in the Wild},
year = {2026},
isbn = {9798400724503},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3788853.3803091},
doi = {10.1145/3788853.3803091},
abstract = {Modern Internet-scale services evolve, yet database interactions are increasingly obscured by languages, frameworks, and abstraction layers. This loss of visibility weakens the link between code changes and SQL behavior, leading to performance regressions, security risks, and costly diagnosis. SQLens is a practical system that restores auditable, end-to-end visibility between application code and executed SQL in large, heterogeneous codebases. It combines static program analysis with LLM-guided reasoning in a closed-loop workflow: starting from database emission sites, cooperative agents traverse control and data flows to reconstruct SQL construction and parameter binding. The system refines these mappings using SQL logs collected over time and stores them in a versioned knowledge layer supporting code-to-SQL lookup and SQL-to-code attribution. Deployed at Alibaba Group and evaluated on diverse open-source services, SQLens achieves high precision and recall in code-to-SQL reconstruction, reduces SQL-incident resolution time, and, when integrated with continuous integration pipelines and runtime observability, supports detection and mitigation of SQL issues, enabling continuous SQL governance at industrial scale.},
booktitle = {Companion of the International Conference on Management of Data},
pages = {504–517},
numpages = {14},
keywords = {code-to-sql visibility, sql provenance, llm},
location = {Bengaluru, India},
series = {SIGMOD Companion '26}
}

@inproceedings{10.1145/3802927.3802944,
author = {Xia, Junhao and Xiong, Boyang and Yan, Xuexiong},
title = {SSRFReaper: An SSRF vulnerability discovery technique based on instruction tracing and fuzzing},
year = {2026},
isbn = {9798400722332},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3802927.3802944},
doi = {10.1145/3802927.3802944},
abstract = {SSRF (Server-Side Request Forgery) is a common web security vulnerability. It was included in both the 2021 OWASP Top 10 and the 2023 OWASP API Top 10, and has also been a common feature in the CWE Top 25 in recent years. SSRF vulnerabilities are becoming increasingly prevalent and their harm is growing. However, accurately detecting SSRF vulnerabilities remains a significant challenge. Existing methods based on static taint analysis and graph traversal have high false positive and false negative rates, and struggle to handle dynamic language features, implicit call chains, and complex purging logic and path conditions. Researchers have proposed a method combining instruction tracing and fuzzing to detect SSRF vulnerabilities. This method does not rely on static modeling but instead dynamically reconstructs the propagation process from attacker input to sensitive network request functions by intercepting and recording low-level instructions during program execution. This mechanism can capture implicit control flow, combine constraint solving to analyze path reachability, and provide higher accuracy for vulnerability verification.},
booktitle = {Proceedings of the 2026 5th International Conference on Cryptography, Network Security and Communication Technology},
pages = {110–116},
numpages = {7},
keywords = {Fuzz testing, Instruction tracing, SSRF vulnerability, Server-side request forgery, Web application security},
location = {Haikou, China},
series = {CNSCT '26}
}

@proceedings{10.1145/3786148,
title = {GREENS '26: Proceedings of the IEEE/ACM 10th International Workshop on Green and Sustainable Software},
year = {2026},
