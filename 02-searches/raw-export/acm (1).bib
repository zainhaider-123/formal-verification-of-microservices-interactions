@inproceedings{10.1145/3786179.3788323,
author = {Rossi, Jacopo and Dimitrov, Georgi Todorov and Monti, Flavia and Leotta, Francesco and Mecella, Massimo},
title = {Domain Specific Language for Service-oriented Aerospace Environments},
year = {2026},
isbn = {9798400724107},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3786179.3788323},
doi = {10.1145/3786179.3788323},
abstract = {The increasing complexity of aerospace missions requires software architectures that combine adaptability with the stringent guarantees of real-time systems. Low-Code/No-Code paradigms offer promising opportunities to accelerate software development and involve domain experts directly in the design process. However, their adoption in aerospace environments remains limited by timing and reliability requirements. This paper presents a modeling and execution approach for service-oriented aerospace software built on top of real time Linux infrastructure, composed of a Domain Specific Language and a No-Code modeling tool. The DSL provides formal semantics to capture functional and non-functional properties, including real-time constraints, resource allocation, and deployment targets. Models are interpreted at runtime to support dynamic service orchestration and reconfiguration, while the tool offers a syntax-safe interface for system modeling. The solution enables the development and evolution of adaptive aerospace software while preserving compliance and determinism.},
booktitle = {Proceedings of the 2026 2nd International Workshop on Low-Code Development and Software Architecture},
pages = {14–22},
numpages = {9},
keywords = {Low-Code/No-Code, Domain Specific Language, Service-oriented orchestration, Aerospace systems},
location = {Rio de Janeiro, Brazil},
series = {LArc '26}
}

