@inproceedings{10.1145/3803437.3806089,
author = {Weerasinghe, Shakthi and Cerny, Tomas},
title = {A Holistic Risk Calculus for Microservice Systems using Multi-Source Signal Fusion},
year = {2026},
isbn = {9798400726361},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803437.3806089},
doi = {10.1145/3803437.3806089},
abstract = {Modern microservices architectures suffer from the fragmented observability problem: Static Application Security Testing tools analyze the code but miss the runtime context; log analysis tools observe the failures but miss the root cause; and risk metrics (such as CVSS) flatten these complex realities into static scalar scores. This paper proposes a Holistic Risk Calculus that unifies these disparate signals. We present a framework that fuses structural evidence (from static analysis), semantic evidence (from semantic dependency graphs), business context (using Large Language Models), and dynamic evidence (from logs and traces). By leveraging Subjective Logic, we replace binary security flags with multi-dimensional "opinions" (belief, disbelief, uncertainty). Furthermore, our calculus could be used to perform abductive reasoning, allowing the system to not only quantify risk but to autonomously reason backwards-from runtime log anomalies to latent vulnerabilities, enabling self-diagnosing security postures.},
booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
pages = {1721–1725},
numpages = {5},
keywords = {neuro-symbolic AI, subjective logic, vulnerabilities, knowledge graph, microservices, symbolic grounding, evidential reasoning},
location = {Montreal, QC, Canada},
series = {FSE Companion '26}
}

