@INPROCEEDINGS{11502900,
  author={Jayakrishnan, Sanat and Jain, Kurunandan and Krishnan, Prabhakar},
  booktitle={2026 9th International Conference on Intelligent Computing and Control Systems (ICICCS)}, 
  title={Lightweight Security Evaluation of MQTT Over eSIM-Based Identity in IoT SAFE Context}, 
  year={2026},
  volume={},
  number={},
  pages={1-10},
  abstract={The rapid expansion of the Internet of Things (IoT) predicts more than 25 billion connected devices as of 2025, which highlights the importance of scalable and strong security measures. Although the Message Queuing Telemetry Transport (MQTT) protocol is sufficient in environments with limited resources, it typically depends on software-based credentials that are vulnerable to theft and spoofing. This study addresses this security issue by introducing a lightweight security framework that combines a hardware-rooted identity using eSIM technology with the MQTT protocol. Using the GSMA IoT SAFE standard, we created a secure root-of-trust (RoT) for mutual TLS authentication and topic-based authorization. Using the ProVerif tool, we were able to formally verify the security features of the protocol, like key secrecy, device authentication, and replay prevention. We also validated the proposed approach using a comprehensive Docker-based testbed implementation. The evaluation shows that the integration effectively counters critical threats, such as identity spoofing and private key leakage, while maintaining low latency (authentication overhead $<100$ ms), making it suitable for real-world IoT deployments with limited resources.},
  keywords={Payloads;Telemetry;Aerospace and electronic systems;Military aircraft;Space technology;Central Processing Unit;MIMICs;Millimeter wave integrated circuits;Monolithic integrated circuits;Electronic circuits;MQTT;eSIM;IoT SAFE;Formal Verification;ProVerif;Hardware Root of Trust;IoT Security},
  doi={10.1109/ICICCS67901.2026.11502900},
  ISSN={},
  month={March},}@INPROCEEDINGS{9065545,
  author={Mirhosseini, Amirhossein and West, Brendan L. and Blake, Geoffrey W. and Wenisch, Thomas F.},
  booktitle={2020 IEEE International Symposium on High Performance Computer Architecture (HPCA)}, 
  title={Q-Zilla: A Scheduling Framework and Core Microarchitecture for Tail-Tolerant Microservices}, 
  year={2020},
  volume={},
  number={},
  pages={207-219},
  abstract={Managing tail latency is a primary challenge in designing large-scale Internet services. Queuing is a major contributor to end-to-end tail latency, wherein nominal tasks are enqueued behind rare, long ones, due to Head-of-Line (HoL) blocking. In this paper, we introduce Q-Zilla, a scheduling framework to tackle tail latency from a queuing perspective, and CoreZilla, a microarchitectural instantiation of our framework. On the algorthmic front, we first propose Server-Queue Decoupled Size-Interval Task Assignment (SQD-SITA), an efficient scheduling algorithm to minimize tail latency for high-disparity service distributions. SQD-SITA is inspired by an earlier algorithm, SITA, which explicitly seeks to address HoL blocking by providing an "express-lane" for short tasks, protecting them from queuing behind rare, long ones. But, SITA requires prior knowledge of task lengths to steer them into their corresponding lane, which is impractical. Furthermore, SITA may underperform an M/G/k system when some lanes become underutilized. In contrast, SQD-SITA uses incremental preemption to avoid the need for a priori task-size information, and dynamically reallocates servers to lanes to increase server utilization with no performance penalty. We then introduce Interruptible SQD-SITA, which further improves tail latency at the cost of additional preemptions. Finally, we describe and evaluate CoreZilla, wherein a multi-threaded core efficiently implements ISQD-SITA in a software-transparent manner at minimal cost. Our evaluation demonstrates that CoreZilla improves tail latency over a conventional SMT core with 2, 4, and 8 contexts by 2.25×, 3.23×, and 4.88×, on average, respectively.},
  keywords={Task analysis;Context;Servers;Organizations;Registers;Queueing analysis;Synchronization},
  doi={10.1109/HPCA47549.2020.00026},
  ISSN={2378-203X},
  month={Feb},}@INPROCEEDINGS{8675221,
  author={Mirhosseini, Amirhossein and Sriraman, Akshitha and Wenisch, Thomas F.},
  booktitle={2019 IEEE International Symposium on High Performance Computer Architecture (HPCA)}, 
  title={Enhancing Server Efficiency in the Face of Killer Microseconds}, 
  year={2019},
  volume={},
  number={},
  pages={185-198},
  abstract={We are entering an era of “killer microseconds” in data center applications. Killer microseconds refer to μs-scale “holes” in CPU schedules caused by stalls to access fast I/O devices or brief idle times between requests in high throughput microservices. Whereas modern computing platforms can efficiently hide ns-scale and ms-scale stalls through micro-architectural techniques and OS context switching, they lack efficient support to hide the latency of μs-scale stalls. Simultaneous Multithreading (SMT) is an efficient way to improve core utilization and increase server performance density. Unfortunately, scaling SMT to provision enough threads to hide frequent μs-scale stalls is prohibitive and SMT co-location can often drastically increase the tail latency of cloud microservices. In this paper, we propose Duplexity, a heterogeneous server architecture that employs aggressive multithreading to hide the latency of killer microseconds, without sacrificing the Quality-of-Service (QoS) of latency-sensitive microservices. Duplexity provisions dyads (pairs) of two kinds of cores: master-cores, which each primarily executes a single latency-critical master-thread, and lender-cores, which multiplex latency-insensitive throughput threads. When the master-thread stalls, the master-core borrows filler-threads from the lender-core, filling μs-scale utilization holes of the microservice. We propose critical mechanisms, including separate memory paths for the master-thread and filler-threads, to enable master-cores to borrow filler-threads while protecting master-threads' state from disruption. Duplexity facilitates fast master-thread restart when stalls resolve and minimizes the microservice's QoS violation. Our evaluation demonstrates that Duplexity is able to achieve 1.9× higher core utilization and 2.7× lower iso-throughput 99th-percentile tail latency over an SMT-based server design, on average.},
  keywords={Servers;Instruction sets;Data centers;Context;Throughput;Switches;Quality of service;Killer Microseconds;Server Architecture;Data centers;Microarchitecture},
  doi={10.1109/HPCA.2019.00037},
  ISSN={2378-203X},
  month={Feb},}@INPROCEEDINGS{9282808,
  author={Jebbar, Oussama and Khendek, Ferhat and Toeroe, Maria},
  booktitle={2020 IEEE 20th International Conference on Software Quality, Reliability and Security (QRS)}, 
  title={Architecture for the Automation of Live Testing of Cloud Systems}, 
  year={2020},
  volume={},
  number={},
  pages={142-151},
  abstract={Live testing is performed in the production environment. In such environment, test activities have to be orchestrated properly to avoid interferences with normal usage traffic. Conducting live testing activities manually is error prone because of the size and the complexity of the system as well as the required complex orchestration of different tasks. Furthermore, it would be impossible to react to failures and contain them in due time without automation. Live testing requires a high level of automation. This automation comes with several challenges especially in contexts such as cloud and zero touch networks because of the diversity of the software composing them. In this paper we discuss the challenges of automating live testing for cloud systems. We propose an architecture that relies on a modeling framework to decouple the specification of testing activities from the platforms needed to conduct them. We propose a solution for conducting testing activities on a live system according to such a specification.},
  keywords={Automation;Computer architecture;Production;Complexity theory;Specification languages;Task analysis;Testing;live testing;cloud;UML Testing Profile;test architecture;automation},
  doi={10.1109/QRS51102.2020.00030},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10628762,
  author={Granadeno, Pedro Antonio Alarcon and Bernal, Arturo Miguel Russell and Al Islam, Md Nafee and Cleland-Huang, Jane},
  booktitle={2024 IEEE 32nd International Requirements Engineering Conference Workshops (REW)}, 
  title={An Environmentally Complex Requirement for Safe Separation Distance Between UAVs}, 
  year={2024},
  volume={},
  number={},
  pages={166-175},
  abstract={Cyber-Physical Systems (CPS) interact closely with their surroundings. They are directly impacted by their physical and operational environment, adjacent systems, user interactions, regulatory codes, and the underlying development process. Both the requirements and design are highly dependent upon assumptions made about the surrounding world, and therefore environmental assumptions must be carefully documented, and their correctness validated as part of the iterative requirements and design process. Prior work exploring environmental assumptions has focused on projects adopting formal methods or building safety assurance cases. However, we emphasize the important role of environmental assumptions in a less formal software development process, characterized by natural language requirements, iterative design, and robust testing, where formal methods are either absent or used for only parts of the specification. In this paper, we present a preliminary case study for dynamically computing the safe minimum separation distance between two small Uncrewed Aerial Systems based on drone characteristics and environmental conditions. In contrast to prior community case studies, such as the mine pump problem, patient monitoring system, and train control system, we provide several concrete examples of environmental assumptions, and then show how they are iteratively validated at various stages of the requirements and design process, using a combination of simulations, field-collected data, and runtime monitoring.},
  keywords={Temperature;Runtime;Conferences;Process control;Safety;Iterative methods;Requirements engineering;requirements;environmental assumptions;small unmanned aerial systems;UAV;case-study},
  doi={10.1109/REW61692.2024.00028},
  ISSN={2770-6834},
  month={June},}@INPROCEEDINGS{10083439,
  author={Steingartner, William and Zsiga, Richard and Radaković, Davorka},
  booktitle={2022 IEEE 16th International Scientific Conference on Informatics (Informatics)}, 
  title={Natural semantics visualization for domain-specific language}, 
  year={2022},
  volume={},
  number={},
  pages={293-298},
  abstract={In this article, we refer to current research in the field of semantic methods for a selected set of domain-specific languages. In our research, we focus on the formulation and definition of semantic methods for describing the meaning of programs in a simple domain-specific language for controlling a robot in an orthogonal system. Considering the importance for current and future programmers and IT specialists to know how programs work and prevent possible mistakes at the design and algorithmic stages, we consider it important in educating young IT professionals to provide them with a solid foundation in formal methods for software engineering. Semantic modeling forms the necessary basis for these formal methods. Therefore, we continue our research by formulating semantic methods for selected domain-specific languages. We also developed a software tool for the mentioned method as a support in education to increase its attractiveness.},
  keywords={Visualization;Semantics;Education;Software algorithms;Solids;Software tools;Informatics;guidelines;issues;experiments;semantics;natural semantics;visualization;efficiency},
  doi={10.1109/Informatics57926.2022.10083439},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11724336,
  author={Mudusu, Sunil Kumar and Gentyala, Sunil and Pendyala, Manasa},
  booktitle={2026 4th International Conference on Intelligent Cyber Physical Systems and Internet of Things (ICoICI)}, 
  title={Anomaly Detection by using Dynamic Knowledge Graph with Temporal Attention Network}, 
  year={2026},
  volume={},
  number={},
  pages={776-784},
  abstract={The Modern cloud infrastructures utilize microservices that offer scalability, flexibility, and resilience. However, traditional models fail to capture the intricate logical dependencies and causal links between distributed components. In addition, fragmented log data across the abstraction layers make manual correlation impossible, leading to critical visibility gaps. This study proposes a hybrid framework that combines a Dynamic Knowledge Graph (DKG) and Temporal Logical Attention Network (TLAN). The DKG helps reconstruct physical-to-virtual structural relationships using an adaptive adjacency matrix that includes Istio traces, raw logs, and Kubernetes orchestration metadata. The TLAN incorporates parallel multi-scale feature extraction, followed by the fusion of bidirectional long short-term memory (BiLSTM) and Graph Attention Network (GAT) to capture sequential patterns and topological dependencies simultaneously. The DKG-TLAN model utilizes cross-layer interdependencies between logical services and physical infrastructure. The temporal and structural patterns are fused by a learnable gating mechanism to identify the common physical point of failure in microservices. The experimental results in the Sock Shop environment demonstrate that the proposed method effectively detects anomalies and facilitates automated services to maintain system resilience.},
  keywords={Modeling;Equations;Anomaly detection;Timing;Clouds;Poles and zeros;Tagging;Printing;Location awareness;Measurement;Anomaly detection;Dynamic Knowledge Graph;Graph Attention Network;Sequential patterns;Topological dependencies;Temporal Logical Attention Network},
  doi={10.1109/ICoICI69824.2026.11724336},
  ISSN={},
  month={Sep.},}@ARTICLE{10129945,
  author={Deng, Zhuolin and Cai, Ming and Xiong, Chen},
  journal={IEEE Intelligent Transportation Systems Magazine}, 
  title={An Architecture Integrity Simulation Evaluation Method for an Autonomous Transportation System Based on an Information-Triggered Collaboration Mechanism}, 
  year={2023},
  volume={15},
  number={5},
  pages={120-133},
  abstract={Autonomous transportation systems (ATSs) focus on traffic services and have become more capable of handling stochastic traffic scenarios. The preliminary work for designing and constructing ATS management and control systems is to develop an instructive and systematic architecture. However, the construction process of a conventional traffic system generally follows a function- and demand-oriented way. Thus, few studies have addressed architecture integrity evaluation and verification. In this work, we propose a collaboration mechanism-based approach to ATS architecture integrity evaluation. First, to provide a clear description of ATSs, ATS theory was systematically introduced through the generation, definition, and property of its basic elements, and then the relations between each element were analyzed based on the concept of microservices. Second, a collaboration mechanism on physical architecture was proposed to realize the adaptive construction of the architecture. Additionally, to fulfill the evaluation of architecture integrity, a contrast scheme combined with system function and information flow (IF) was determined, and accordingly, two independent ways were determined to obtain both the reference and calculated results. Finally, the scenario of automatic vehicles passing through an intersection was illustrated to demonstrate the feasibility of this static simulation evaluation method for the scenario architecture, and achieved a 100% function integrity rate and 93.3% IF integrity rate. A successful application in the case study shows that the proposed method could be extended to more general traffic scenarios.},
  keywords={Computer architecture;Object oriented modeling;Unified modeling language;Collaboration;Computational modeling;Microservice architectures;Autonomous vehicles;Intelligent transportation systems},
  doi={10.1109/MITS.2023.3272501},
  ISSN={1941-1197},
  month={Sep.},}@ARTICLE{10843205,
  author={López-Pimentel, Juan-Carlos and del-Valle-Soto, Carolina and Valdivia, Leonardo J. and Monroy, Raúl},
  journal={IEEE Access}, 
  title={Emphasizing the Early Phases of the Software Development Process Before Deploying Smart Contracts}, 
  year={2025},
  volume={13},
  number={},
  pages={13628-13643},
  abstract={Immutability is one of the main characteristics of Blockchain. However, most software development is not static. This dilemma, among others, has caused a new branch of blockchain-oriented software engineering. This paper emphasizes the importance of the early phases of software development before deploying blockchain-based software. It follows case-based research to illustrate the implications of smart contracts designed in the early phases without including all requirements. The paper presents a digital identity case designed within a microservice architecture. We show two stages: an initial design and an upgrading requirement, which causes considerable changes in the architecture. The case is analyzed from three different perspectives: 1) Economic, finding that re-deploying smart contracts does not implicate considerable cost; 2) Computational perspective, finding that it generates various implications: smart contract purpose duplication, storage wastage, failure to recognize the original smart contract, cascade dependency repercussion, and migration problems; and 3) Interconnected effect, a simple change, required for upgrading smart contracts, generates broad collateral repercussions in both on-chain (within the blockchain) and off-chain.},
  keywords={Smart contracts;Blockchains;Software;Testing;Software development management;Software engineering;Computer architecture;Codes;Computer bugs;Penetration testing;Blockchain;software-development;smart contract;upgrading},
  doi={10.1109/ACCESS.2025.3530269},
  ISSN={2169-3536},
  month={},}@ARTICLE{8853255,
  author={Kufner, Josef and Mařík, Radek},
  journal={IEEE Access}, 
  title={Restful State Machines and SQL Database}, 
  year={2019},
  volume={7},
  number={},
  pages={144603-144617},
  abstract={State machines and a relational database may look like completely unrelated tools, yet they form an interesting couple. By supporting them with well-established architectural patterns and principles, we built a model layer of a web application which utilizes the formal aspects of the state machines to aid the development of the application while standing on traditional technologies. The layered approach fits well with existing frameworks and the Command-Query Separation pattern provides a horizontal separation and compatibility with various conceptually distinct storages, while the overall architecture respects RESTful principles and the features of the underlying SQL database. The integration of the explicitly specified state machines as first-class citizens provides a reliable connection between the well-separated formal model and the implementation; it enables us to use visual comprehensible formal models in a practical and effective way, and it opens new possibilities of using formal methods in application development and business process modeling.},
  keywords={Business;Unified modeling language;Databases;Computer architecture;Automata;Data models;Computational modeling;State machine;web application;REST;MVC;multi-tier architecture;CQS;CQRS;ORM;SQL},
  doi={10.1109/ACCESS.2019.2944807},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11567049,
  author={Chang, Shengjie and Wang, Ze},
  booktitle={2026 6th International Conference on Artificial Intelligence and Industrial Technology Applications (AIITA)}, 
  title={Autonomous Workflow Method Based on Multi-Agent Orchestration for Dynamic Scheduling and Execution of Typical Tasks in DevOps Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1565-1571},
  abstract={To address the poor adaptability of static workflows in cloud-native DevOps pipelines and the latency and single point of failure issues in centralized orchestration, an autonomous workflow method based on multi-agent orchestration is proposed. A hierarchical multi-agent architecture is constructed, encompassing five types of agents, and adopting a distributed autonomous and centralized collaborative mode. An interaction mechanism based on a knowledge query language and a token ring strategy are designed to reduce concurrency conflicts and communication latency. Formal workflow modeling is achieved using colored Petri nets to accurately describe task dependencies and state transitions. A reinforcement learning-driven scheduling algorithm is proposed, combined with the analytic hierarchy process (AHP) to achieve task priority ranking and load balancing. A full-dimensional monitoring and hierarchical anomaly self-healing mechanism is constructed to support three levels of anomaly handling. Experiments show that the method reduces end-to-end latency by 32.7 % under high-load scenarios and significantly improves task scheduling success rate, effectively enhancing the pipeline's adaptability and robustness, and providing support for building highly resilient pipelines.},
  keywords={Schedules;DevOps;Loading;Modeling;Pipelines;Scheduling;Timing;Resource management;Equations;Intelligent agents;Multi-Agent Orchestration;Autonomous Workflow;DevOps Pipeline;Dynamic Scheduling},
  doi={10.1109/AIITA69518.2026.11567049},
  ISSN={},
  month={April},}@ARTICLE{9540368,
  author={Sane, Ketki and Joshi, Karuna Pande and Mittal, Sudip},
  journal={IEEE Transactions on Services Computing}, 
  title={Semantically Rich Framework to Automate Cyber Insurance Services}, 
  year={2023},
  volume={16},
  number={1},
  pages={588-599},
  abstract={With the rapid enhancements in technology and the adoption of web services, there has been a significant increase in cyber threats faced by organizations in cyberspace. It has become essential to get financial cover to mitigate the expenses due to a security incident. Organizations want to purchase adequate cyber insurance to safeguard against the third-party services they use. However, cyber insurance policies describe their coverages and exclusions using legal jargon that can be difficult to comprehend. Parsing these policy documents and extracting the rules embedded in them is currently a very manual time-consuming process. We have developed a novel framework that automatically extracts the coverage and exclusion key terms and rules embedded in a cyber policy. We have built our framework using Information Retrieval and Artificial Intelligence techniques, specifically Semantic Web and Modal Logic. We have also developed a web interface where users can find the best matching cyber insurance policy based on particular coverage criteria. To validate our approach, we used industry standards proposed by the Federal Trade Commission document (FTC) and have applied it against publicly available policies of seven insurance providers. Our system will allow cyber insurance seekers to explore various policy documents and compare the paradigms mentioned in those documents while selecting the best relevant policy documents.},
  keywords={Insurance;Ontologies;Organizations;Law;User interfaces;Standards organizations;Stakeholders;Cybersecurity;artificial intelligence;cyber insurance;knowledge graph;ontology;knowledge representation;policies},
  doi={10.1109/TSC.2021.3113272},
  ISSN={1939-1374},
  month={Jan},}@INPROCEEDINGS{11039279,
  author={Herbold, Steffen and Knieke, Christoph and Rausch, Andreas and Schindler, Christian},
  booktitle={2025 IEEE/ACM 1st International Workshop on Neuro-Symbolic Software Engineering (NSE)}, 
  title={Neurosymbolic Architectural Reasoning: Towards Formal Analysis through Neural Software Architecture Inference}, 
  year={2025},
  volume={},
  number={},
  pages={5-10},
  abstract={Formal analysis to ensure adherence of software to defined architectural constraints is not yet broadly used within software development, due to the effort involved in defining formal architecture models. Within this paper, we outline neural architecture inference to solve the problem of having a formal architecture definition for subsequent symbolic reasoning over these architectures, enabling neurosymbolic architectural reasoning. We discuss how this approach works in general and outline a research agenda based on six general research question that need to be addressed, to achieve this vision.},
  keywords={Codes;Software architecture;Large language models;Conferences;Neural networks;Computer architecture;Cognition;Software;Distance measurement;Software development management;software architecture;neural networks;large language models;architecture inference;neurosymbolic architectural reasoning},
  doi={10.1109/NSE66660.2025.00008},
  ISSN={},
  month={May},}@INPROCEEDINGS{11360398,
  author={Zhang, Xinge and He, Yuyu and Chen, Yanli and Wang, Zhigang and Lu, Hui and Wu, JingHang},
  booktitle={2025 IEEE 10th International Conference on Data Science in Cyberspace (DSC)}, 
  title={Unlocking the Next Generation of REST API Security: A Critical Analysis of the Path from Fuzzing to LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={472-479},
  abstract={The proliferation of REST APIs has made them foundational to modern software architectures yet also a primary attack surface, rendering the study of effective vulnerability discovery techniques critical. This paper provides a systematic survey of nearly 60 seminal publications, classifying existing methods and tracing their evolution from stateless black-box fuzzing to sophisticated approaches driven by Large Language Models (LLMs). Our synthesis reveals persistent, interlocking challenges that hinder progress, namely complex state maintenance, the test oracle problem for business logic, environmental fidelity, and the lack of standardized evaluation benchmarks. By clarifying the technological landscape and its core challenges, this survey identifies key future research directions: leveraging LLMs as cognitive engines for testing, embedding security into DevSecOps workflows, expanding analysis to emerging protocols, and enhancing the explainability of automated findings.},
  keywords={Surveys;Protocols;Systematics;Large language models;Fuzzing;Trajectory;Maintenance;Security;Logic;Engines;REST API;API Security;Vulnerability Discovery;Fuzzing;Static Analysis;Dynamic Analysis;Large Language Models (LLM);OWASP},
  doi={10.1109/DSC67331.2025.00067},
  ISSN={},
  month={Aug},}@BOOK{9540748,
  author={Jackson, Daniel},
  booktitle={The Essence of Software: Why Concepts Matter for Great Design},
  year={2021},
  volume={},
  number={},
  pages={},
  abstract={A revolutionary concept-based approach to thinking about, designing, and interacting with softwareAs our dependence on technology increases, the design of software matters more than ever before. Why then is so much software flawed? Why hasn’t there been a systematic and scalable way to create software that is easy to use, robust, and secure?Examining these issues in depth, The Essence of Software introduces a theory of software design that gives new answers to old questions. Daniel Jackson explains that a software system should be viewed as a collection of interacting concepts, breaking the functionality into manageable parts and providing a new framework for thinking about design. Through this radical and original perspective, Jackson lays out a practical and coherent path, accessible to anyone—from strategist and marketer to UX designer, architect, or programmer—for making software that is empowering, dependable, and a delight to use.Jackson explores every aspect of concepts—what they are and aren’t, how to identify them, how to define them, and more—and offers prescriptive principles and practical tips that can be applied cost-effectively in a wide range of domains. He applies these ideas to contemporary software designs, drawing examples from leading software manufacturers such as Adobe, Apple, Dropbox, Facebook, Google, Microsoft, Twitter, and others. Jackson shows how concepts let designers preserve and reuse design knowledge, rather than starting from scratch in every project.An argument against the status quo and a guide to improvement for both working designers and novices to the field, The Essence of Software brings a fresh approach to software and its creation.},
  keywords={},
  doi={},
  ISSN={},
  publisher={Princeton University Press},
  isbn={9780691230542},
  url={https://ieeexplore.ieee.org/document/9540748},}@INPROCEEDINGS{11670188,
  author={Li, Xinhui and Yang, Zhongguo and Li, Di and Jiang, Yonglu and Li, Juan},
  booktitle={2026 IEEE International Conference on Web Services (ICWS)}, 
  title={SkaaS: A Skill-as-a-Service Architecture for Stateful Service Reasoning in Manual Procedures via FSM-Constrained Multimodal LLMs}, 
  year={2026},
  volume={},
  number={},
  pages={603-613},
  abstract={Under the Everything-as-a-Service (XaaS) paradigm, human skills can be provisioned as cloud services. In strict domains like healthcare and manufacturing, these skills are formalized as Standard Operating Procedures (SOPs). Multimodal Large Language Models (MLLMs) offer great potential for automating SOP diagnostics as a Skill-as-a-Service (SkaaS). However, deploying MLLMs for this stateful service reasoning is challenging. Over long video inputs, their visual attention dilutes. They also hallucinate and miss critical SOP state transitions, severely degrading service reliability. To address this, we propose a novel SkaaS architecture. Our framework automatically translates unstructured manual procedures into computable service entities. First, it segments long videos to maintain AI attention and leverages Retrieval-Augmented Generation (RAG) to dynamically generate standardized SOP entities from visual inputs and expert knowledge. Finally, a Finite State Machine (FSM) orchestrates the diagnostic workflow as strict post-processing logic. It computes the MLLM outputs to ensure deterministic service reasoning. This eliminates hallucinations and captures precise sequence errors. We validated SkaaS on a cross-domain benchmark. In the generation phase, it achieves a 0.873 BGE semantic similarity. In the diagnostic reasoning phase, it reaches a 0.893 macro-average F1 score. Notably, it boosts sequence error detection from a 0.12 baseline to 0.84. Ultimately, SkaaS delivers a reliable generative AI approach for SOP service reasoning.},
  keywords={Modeling;Cognition;Cognitive systems;Videos;Printing;Architecture;Computer architecture;Manuals;Visualization;Sequences;Everything-as-a-Service (XaaS);Service Reasoning;Skill-as-a-Service;Standard Operating Procedure (SOP);Multimodal Large Language Models;Finite State Machine;Service Reliability},
  doi={10.1109/ICWS72778.2026.00078},
  ISSN={2836-3868},
  month={July},}@ARTICLE{9771454,
  author={Wu, Canghai and Xiong, Jie and Xiong, Huanliang and Zhao, Yingding and Yi, Wenlong},
  journal={IEEE Access}, 
  title={A Review on Recent Progress of Smart Contract in Blockchain}, 
  year={2022},
  volume={10},
  number={},
  pages={50839-50863},
  abstract={A smart contract, in form, is represented as a piece of computer program code involving related commercial transactions and algorithms. Essentially, this is the computerization of the pre-agreed contract between the participants. This special contract agreement is automatically verified and executed once preset conditions are triggered. Smart contracts are not only used in the field of financial transactions, but also include many aspects of social life. Although smart contract technology has unique advantages, it is still in the early stages of development, and many problems remain to be solved. First, this article briefly summarizes the development process of blockchain, and then focuses on the research progress of blockchain 2.0-smart contracts. Second, the related concepts of smart contracts are presented, and the working mechanism of smart contracts and the difficulties faced by smart contracts are elaborated. Finally, in response to these problems and dilemmas, the corresponding solutions and ideas are summarized, and the future challenges and development trends of smart contracts are analyzed and judged.},
  keywords={Smart contracts;Blockchains;Codes;Virtual machining;Bitcoin;Automation;Blockchain;smart contract;transaction automation;non tamperability},
  doi={10.1109/ACCESS.2022.3174052},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11023400,
  author={Akon, Mujtahid and Toufikuzzaman, Md and Hussain, Syed Rafiul},
  booktitle={2025 IEEE Symposium on Security and Privacy (SP)}, 
  title={From Control to Chaos: A Comprehensive Formal Analysis of 5G's Access Control}, 
  year={2025},
  volume={},
  number={},
  pages={1081-1100},
  abstract={We develop CoreScan, a comprehensive formal analysis framework for analyzing the access control mechanism of 5G core networks. In doing so, we build the first comprehensive formal model for the access control mechanism of 5G core network that considers the indirect communication mode and 5G roaming. Given a global property, CoreScan employs the compositional verification technique that leverages the assume-guarantee style reasoning approach to decompose the system model into multiple disjoint components and applies the split assertion principle to identify local assumptions and guarantees. The model's global security property holds if and only if all local guarantees derived from the global property are verified in their respective components. CoreScan features a configurable adversary model, enabling the evaluation of access control properties under diverse adversary capabilities. We tested 61 access control properties with CoreScan and uncovered five new classes of exploitable privilege escalation vulnerabilities in the 5G standards. Additionally, we found that most previously known overprivilege vulnerabilities in direct communication also extend to indirect communication and roaming settings.},
  keywords={Access control;Chaos;Privacy;5G mobile communication;Cognition;Standards;5g core network;access control;formal analysis;vulnerabilities},
  doi={10.1109/SP61157.2025.00141},
  ISSN={2375-1207},
  month={May},}@INPROCEEDINGS{9359214,
  author={Zhao, Zhiming and Rong, Chunming and Jaatun, Martin Gilje},
  booktitle={2020 IEEE 26th International Conference on Parallel and Distributed Systems (ICPADS)}, 
  title={A Trustworthy Blockchain-based Decentralised Resource Management System in the Cloud}, 
  year={2020},
  volume={},
  number={},
  pages={617-624},
  abstract={Quality Critical Decentralised Applications (QC-DApp) have high requirements for system performance and service quality, involve heterogeneous infrastructures (Clouds, Fogs, Edges and IoT), and rely on the trustworthy collaborations among participants of data sources and infrastructure providers to deliver their business value. The development of the QCDApp has to tackle the low-performance challenge of the current blockchain technologies due to the low collaboration efficiency among distributed peers for consensus. On the other hand, the resilience of the Cloud has enabled significant advances in software-defined storage, networking, infrastructure, and every technology; however, those rich programmabilities of infrastructure (in particular, the advances of new hardware accelerators in the infrastructures) can still not be effectively utilised for QCDApp due to lack of suitable architecture and programming model.},
  keywords={System performance;Collaboration;Blockchain;Computer architecture;Programming;Hardware;Resilience;DevOps;Cloud Computing;Blockchain},
  doi={10.1109/ICPADS51040.2020.00086},
  ISSN={2690-5965},
  month={Dec},}@INPROCEEDINGS{10011502,
  author={Kirchhof, Jörg Chrisitian and Malcher, Lukas and Michael, Judith and Rumpe, Bernhard and Wortmann, Andreas},
  booktitle={2022 48th Euromicro Conference on Software Engineering and Advanced Applications (SEAA)}, 
  title={Web-Based Tracing for Model-Driven Applications}, 
  year={2022},
  volume={},
  number={},
  pages={374-381},
  abstract={Logging still is a core functionality used to understand the behavior of programs and executable models. Yet, modeling languages rarely consider logging as a first-level activity that is manifested in the language through modeling elements or their behavior. When logging is part of the code generated for the respective models or the corresponding runtime environment only, it must be generic, as the modeler cannot influence, through the models, what and when logging takes place. To enable modelers to log model behavior, we devised a method based on language extension and smart code generation that can integrate logging into arbitrary textual modeling languages. Based on this method, log entries can be produced, traced, and presented through a web application. This method and its infrastructure can facilitate lifting logging to the model level and, hence, improve the understanding of executable models.},
  keywords={Runtime environment;Codes;Software;Behavioral sciences;Software engineering;Software Engineering;Model-Driven Development;Internet of Things},
  doi={10.1109/SEAA56994.2022.00066},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{10885589,
  author={Chowdhary, Neha and Satapathy, Utkalika and Benson, Theophilus and Chattopadhyay, Subhrendu and Kodeswaran, Palani and Sen, Sayandeep and Chakraborty, Sandip},
  booktitle={2025 17th International Conference on COMmunication Systems and NETworks (COMSNETS)}, 
  title={BeeGuard: Explainability-based Policy Enforcement of eBPF Codes for Cloud-native Environments}, 
  year={2025},
  volume={},
  number={},
  pages={757-765},
  abstract={eBPF enables loading user space code into the kernel, thereby extending the kernel functionalities in an application-aware manner. This flexibility has led to the widespread adoption of the technology across hyperscalers and enterprises for several use cases, including observability, security, network policy enforcement, etc. In general, the safety of the loaded eBPF programs are ensured through a kernel verifier that performs different syntactic/structural checks to secure the kernel against unwanted crashes. In this paper, we motivate the case that this verifier-based security check, while necessary, is insufficient to ensure that the deployed eBPF code complies with organizational policies. Consequently, we propose BeeGuard, a framework to understand program behavior to extract capability lists from eBPF programs. BeeGuard introduces a policy compliance layer on top of the existing verifier, and the extracted capability lists of a program are then checked against organizational policies to allow or block loading the programs. Thorough experiments across the most popular open-source eBPF tools show that BeeGuard can enforce typical enterprise policies with minimal overhead in terms of loading latency and resource utilization.},
  keywords={Codes;Communication systems;Loading;Computer crashes;Safety;Security;Resource management;Kernel;Observability;eBPF;observability;kernel verifier;policy compliance},
  doi={10.1109/COMSNETS63942.2025.10885589},
  ISSN={2155-2509},
  month={Jan},}@INPROCEEDINGS{11087934,
  author={Bindick, Sebastian and Kausch, Hendrik and Pfeiffer, Mathias and Raco, Deni and Rath, Amelie and Rumpe, Bernhard and Schweiger, Andreas},
  booktitle={2025 8th International Conference on Software and System Engineering (ICoSSE)}, 
  title={Communication and Architectural Patterns for Developing Distributed Systems}, 
  year={2025},
  volume={},
  number={},
  pages={31-38},
  abstract={This work explores at first various communication patterns, analyzing their strengths and trade-offs for distributed systems. Two architectural patterns are then evaluated with regard to their typical communication pattern and overall methodical approach. The contribution lies in offering insights into how different communication and architectural patterns are applicable for efficiently designing high quality distributed systems.},
  keywords={Couplings;Systems engineering and theory;Software;Distributed System;Communication Pattern;Architectural Pattern;Tight Cohesion;Loose Coupling},
  doi={10.1109/ICoSSE65712.2025.00014},
  ISSN={},
  month={April},}@INPROCEEDINGS{11670207,
  author={Beheshti, Amin and Chang, Rong N. and Benatallah, Boualem and Casati, Fabio and Dustdar, Schahram and Fox, Geoffrey and Sheng, Quan Z. and Wang, Yan and Yang, Jian and Zomaya, Albert},
  booktitle={2026 IEEE International Conference on Web Services (ICWS)}, 
  title={Agentic Service-Oriented Computing: A Manifesto for the Next Frontier of Service-Oriented Computing}, 
  year={2026},
  volume={},
  number={},
  pages={1291-1303},
  abstract={The rapid emergence of LLM-powered autonomous and semi-autonomous agents is reshaping software systems from static, request-response components into goal-directed, adaptive, and tool-using computational actors. As these agents move from isolated cognitive prototypes into complex distributed workflows, they confront challenges that the Service-Oriented Computing community has studied for more than two decades: composition, interoperability, quality of service, lifecycle management, governance, security, and trust. Yet much of today's agentic AI ecosystem is developing these foundations ad hoc, without the engineering rigour required for dependable enterprise and societal deployment. This paper introduces Agentic Service-Oriented Computing (ASOC) as a new research and practice area concerned with engineering agents as services, orchestrating services through autonomous and semi-autonomous agents, and governing ecosystems of agents and services under constraints of trust, cybersecurity, compliance, performance, and accountability. We articulate six foundational principles of ASOC (harness-ability, composability, lifecycle engineering, trustworthiness by design, goal-driven orchestration, and observability/accountability) and organise a five-dimensional research agenda spanning: (i) agentic services foundations and lifecycle engineering; (ii) composition, orchestration, and interoperability; (iii) governance, observability, and accountability; (iv) security, trust, and risk management; and (v) evaluation, certification, and Agentic QoS. We argue that the Services Computing community is especially well positioned to provide the conceptual and engineering spine for this emerging field, transforming agentic AI from fragmented demonstrations into dependable, service-based systems worthy of human and organisational trust.},
  keywords={Modeling;Contracts;Quality of service;Tools;Printing;Large language models;Service computing;System-on-chip;Security;Artificial intelligence;Agentic Service-Oriented Computing;Agentic Services Architecture;Service-Oriented Computing;ServiceOriented Architecture;Foundation Models;Large Language Models;Multi-Agent Systems;AI Governance;Service Composition;Agent Lifecycle;Service Engineering;Autonomous Agents;Trustworthy AI},
  doi={10.1109/ICWS72778.2026.00163},
  ISSN={2836-3868},
  month={July},}@ARTICLE{11684921,
  author={Torrellas, Josep and Yu, Minlan and Martínez, José F. and Teodorescu, Radu and Zhang, Zhiru and Zhang, Zhengya and Abdelzaher, Tarek and Alian, Mohammad and Belay, Adam and Gupta, Rajesh and Krishna, Tushar and Krishnamurthy, Arvind and Kozyrakis, Christos and Mendis, Charith and Mitra, Subhasish and Shahbaz, Muhammad and Singh, Rachee and Swanson, Steven and Taylor, Michael and Tiwari, Mohit and Yan, Mengjia},
  journal={IEEE Micro}, 
  title={The ACE Center for Evolvable Computing}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents some of the main research contributions of the ACE Center for Evolvable Computing—an SRC/DARPA JUMP 2.0 center focused on systems and architectures for distributed compute. ACE’s goal is to devise novel technologies for distributed computing that substantially improve the energy efficiency and performance of applications. The research encompasses computing engines; memory and storage; communication and coordination; and security, privacy, and correctness.},
  keywords={Modeling;Memory;Design methodology;Hardware;Security;Program processors;Central Processing Unit;Timing;Training;Dies},
  doi={10.1109/MM.2026.3731147},
  ISSN={1937-4143},
  month={},}@INPROCEEDINGS{11541429,
  author={Jaiswal, Nilesh and Pappu, Karthik and Gangaiah, Yogeesh Kunigal},
  booktitle={2026 International Conference on Artificial Intelligence, Systems, and Emerging Technologies (ICAISET)}, 
  title={SATHOS: Self-Adaptive Trust-Hierarchical Orchestration for Zero-Trust DevSecOps Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={1-7},
  abstract={Modern DevSecOps pipelines execute workloads across heterogeneous environments, including cloud runners, on-premises agents, and ephemeral containers, yet orchestration frameworks assume pre-trusted execution agents and rely on static policy gates. This assumption fails under agent compromise, configuration drift, and trust asymmetry between cloud and on-premises zones. We present SATHOS (Self-Adaptive Trust-Hierarchical Orchestration System), a zero-trust orchestration framework that models CI/CD pipelines as trust-governed directed acyclic graphs (DAGs) where each node’s execution is conditioned on dynamically evolving four-dimensional trust vectors covering identity, platform, behavioral, and contextual evidence. SATHOS introduces a distributed trust negotiation protocol over mutual TLS with replay protection and cryptographic transcript verification, combined with a self-adaptive trust evolution mechanism that adjusts trust scores based on execution outcomes without requiring policy redeployment. Evaluated on a Kubernetes-based testbed with three pipeline topologies (3–5 nodes), three experimental conditions, and three random seeds (27 runs), SATHOS blocks 100% of compromised agent execution requests with zero false positives (p < 0.001, Fisher’s exact test). The five-message trust negotiation protocol adds a median per-node latency of 4.73 ms (p50), and the Wilcoxon signed-rank test confirms bounded overhead (p = 0.065, one-sided). The system achieves zero false allows and zero false denies across all trial configurations.},
  keywords={Pipelines;Modeling;Testing;Poles and zeros;Printing;Protocols;Security;Clouds;Conferences;Zero Trust;zero-trust;DevSecOps;CI/CD pipeline security;trust-conditioned orchestration;SPIFFE;distributed trust negotiation;self-adaptive trust},
  doi={10.1109/ICAISET66439.2026.11541429},
  ISSN={},
  month={April},}@INPROCEEDINGS{11755244,
  author={Ileana, Marian and Petrov, Pavel and Milev, Vassil},
  booktitle={2026 International Conference on Cybersecurity and AI-Based Systems (Cyber-AI)}, 
  title={Distributed Web Systems in the 6G Era: A Reference Architecture, Opportunities, and Research Directions}, 
  year={2026},
  volume={},
  number={},
  pages={808-812},
  abstract={Distributed web systems underpin contemporary digital services, yet the fifth generation of mobile networks constrains emerging workloads that demand sub-millisecond latency, massive device connectivity, pervasive intelligence, and strong security guarantees. The sixth generation of mobile communications, standardized by the International Telecommunication Union as IMT-2030, promises terahertz spectrum, reconfigurable intelligent surfaces, network slicing, artificial-intelligence-native control, integrated sensing and communication, and a tightly coupled edge-cloud continuum. This paper argues that these capabilities can reshape how distributed web systems are designed, deployed, and operated. We make three contributions. First, we propose a layered reference architecture that maps 6G enablers onto the functional requirements of distributed web systems, spanning radio access, the edge-cloud compute continuum, web services, embedded intelligence, and a cross-cutting security and orchestration plane. Second, we provide a qualitative analysis of how 6G addresses the latency, scalability, reliability, security, and energy-efficiency limitations of current systems. Third, we identify open challenges and a research agenda, with emphasis on the formal specification, verification, and validation of distributed web systems operating over dynamically sliced 6G infrastructure, and on federated anomaly detection at the network edge. The study is conceptual and is intended to guide subsequent design and empirical work.},
  keywords={Printing;Architecture;Computer architecture;Artificial intelligence;Security;Technology;Reconfigurable intelligent surfaces;Internet of Things;Design methodology;Visual systems;distributed web systems;6G;IMT-2030;edgecloud continuum;reconfigurable intelligent surfaces;network slicing;federated learning;reference architecture},
  doi={10.1109/Cyber-AI70573.2026.11755244},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{10647064,
  author={Zhang, Yang and Wang, Long and Wang, Zhengang and Shangguan, Dongdong},
  booktitle={2024 54th Annual IEEE/IFIP International Conference on Dependable Systems and Networks - Supplemental Volume (DSN-S)}, 
  title={Exploring Use of Symbolic Execution for Service Analysis}, 
  year={2024},
  volume={},
  number={},
  pages={12-16},
  abstract={Service computing is growing popular thanks to the cloud computing technology. However, the behavior of cloud services is complicated as they involve a large number of components and complex interactions between them. It is highly helpful for service users and providers to well understand the service behavior if they can exhaustively explore potential component interactions and service scenarios. This paper discusses the challenges associated with this and an approach to achieving this goal. This paper also reports our progress of exploring the use of symbolic execution for service analysis, together with our research plan.},
  keywords={Computers;Cloud computing;Codes;Service computing;System analysis and design;distributed service;symbolic execution;system analysis;code representation},
  doi={10.1109/DSN-S60304.2024.00014},
  ISSN={2833-292X},
  month={June},}@INPROCEEDINGS{11506523,
  author={Chennareddy, Raj Kiran and Thalary, Sumith Sunny Dayal and Kuntamukkala, Narendra Kumar and Sowmiya Manoj, M.},
  booktitle={2026 IEEE Madhya Pradesh Section Conference (MPCON)}, 
  title={Designing Resilient Enterprise AI Platforms: Integrating Angular-Based Intelligent Interfaces with DevOps-Driven Operational Excellence}, 
  year={2026},
  volume={},
  number={},
  pages={1137-1142},
  abstract={As AI capabilities grow into large-scale, missioncritical environments, organizations will need more than stable infrastructure, they will need enhanced reliability based on model behavior, data quality, and human interaction. Oldfashioned software resilience approaches aren't good enough to meet AI-specific challenges (e.g., probabilistic outputs, model drift, continuous delivery cycles). This paper proposes an overall framework for high-resilience enterprise AI building platform on the backbone support of robust AI, comprising end-to-end fault-tolerant architecture, intelligent Angular-based presentation layer, and DevOps-driven operational excellence. The architecture described follows an inference resilience mesh, model governance plane, feature reliability layer, and experience layer that integrates Angular applications. Reliability is considered by means of quantitative metrics like platform availability, model reliability scores, and cascading failure probabilities; mechanisms to ensure resilience are included in the framework, including circuit breakers, ensemble fallbacks, model versioning, and self-healing pipelines; that is, they can be used to maintain business continuity in the event of partial failures. Angular adopts reactive degradation patterns, confidence-aware components, and real-time health streams on the frontend, and provide a secure and responsive user experience in the presence of uncertain AI outputs. DevOps pipelines have canary releases, automated rollbacks, chaos testing, and advanced observability to watch both AI behavior and infrastructure signals. This combination of features decreases recovery time, builds user trust, and enables proven Service Level Objectives in enterprise AI for reliable enterprise systems.},
  keywords={Artificial intelligence;Modeling;Printing;Resilience;DevOps;Degradation;Timing;Monitoring;Pipelines;Architecture;Resilient AI Platforms;Enterprise AI Architecture;Fault-Tolerant Intelligent Systems;Angular Frontend Integration;DevOps for AI;Model Reliability Engineering;AI Observability;Circuit Breaker Pattern;Graceful Degradation;MLOps Resilience;Scalable AI Services;Human-in-the-Loop AI;Platform Reliability Metrics},
  doi={10.1109/MPCON69668.2026.11506523},
  ISSN={},
  month={March},}@INBOOK{10515105,
  author={Homes, Bernard},
  booktitle={Advanced Testing of Systems-of-Systems, Volume 2: Practical Aspects}, 
  title={Future Testing Challenges}, 
  year={2023},
  volume={},
  number={},
  pages={223-251},
  abstract={Summary <p>Technical debt is a reality in any development project. Measuring the technical debt therefore makes it possible to identify the increase in this debt and to determine whether this debt is becoming too high. Development teams deal with their technical debt in refactoring phases; test teams must deal with their own technical debt each campaign and during each sprint. The specifics related to testing software, systems with preponderant software and systems&#x2010;of&#x2010;systems are important and not covered in most project management frameworks, nor taught in most IT project managers' courses. An important aspect to manage in the context of DevOps is the separation of the technical aspect from the business aspect. The internet of things represents an interesting challenge for systems&#x2010;of&#x2010;systems testing. The concept of Big Data is often associated with the use of predictive analytics, behavioral analytics or other analytical methods that extract value from very large volumes of data.</p>},
  keywords={Testing;Codes;Costs;Software;Documentation;Delays;Organizations},
  doi={10.1002/9781394188482.ch13},
  ISSN={},
  publisher={Wiley},
  isbn={9781394188468},
  url={https://ieeexplore.ieee.org/document/10515105},}@INPROCEEDINGS{9835522,
  author={Okuno, Shingo and Hirai, Akira and Fukumoto, Naoto},
  booktitle={2022 IEEE International Parallel and Distributed Processing Symposium Workshops (IPDPSW)}, 
  title={Performance Analysis of Multi-Containerized MD Simulations for Low-Level Resource Allocation}, 
  year={2022},
  volume={},
  number={},
  pages={1014-1017},
  abstract={This study discusses scheduling strategies to maximize ensemble throughput, which is the total throughput of multiple containers running simultaneously. Such a strategy is useful, for example, in ensemble runs of molecular dynamics (MD) simulations. To design the strategies, we need to tackle two major challenges: (1) how many containers and how many threads per container we should allocate, and (2) which low-level resources we should allocate to reflect workload characteristics. In particular, the latter challenge is important and inevitable for performance-sensitive applications because they effectively utilize low-level hardware such as simultaneous multi-threading (SMT) to maximize performance, while most container platforms do not handle the challenge. In this paper, as a preliminary experiment to implement scheduling strategies related to SMT, we examined whether ensemble throughput of MD simulations can be improved by deploying containers on separate logical cores even when they share the same physical cores. As a result, we obtained a 2.22-fold ensemble throughput compared with a one-container execution with 10 physical cores.},
  keywords={Analytical models;Distributed processing;Instruction sets;Conferences;Containers;Throughput;Hardware;container scheduling;low-level resources;simulta-neous multi-threading;molecular dynamics;ensemble simulation},
  doi={10.1109/IPDPSW55747.2022.00162},
  ISSN={},
  month={May},}@INPROCEEDINGS{10426195,
  author={A, Norton Stanley S and Sebastian, Shoney},
  booktitle={2023 Global Conference on Information Technologies and Communications (GCITC)}, 
  title={Circuit Breaker: A Resilience Mechanism for Cloud Native Architecture}, 
  year={2023},
  volume={},
  number={},
  pages={1-8},
  abstract={Over the past decade, the utilization of cloud native applications has gained significant prominence, leading many organizations to swiftly transition towards developing software applications that leverage the powerful, accessible, and efficient cloud infrastructure. As these applications are deployed in distributed environments, there arises a need for reliable mechanisms to ensure their availability and dependability. Among these mechanisms, the circuit breaker pattern has emerged as a crucial element in constructing resilient and trustworthy cloud native applications in recent times. This research article presents a comprehensive review and analysis of circuit breaker patterns and their role within cloud-native applications. The study delves into various aspects of circuit breakers, encompassing their design, implementation, and recommended practices for their utilization in cloud native applications. Additionally, the article examines and compares different circuit breaker libraries available for employment in modern software development. The paper also presents a concept for improving the circuit breaker pattern, which will be pursued in our upcoming research.},
  keywords={Circuit breakers;Computer architecture;Organizations;Libraries;Software;Integrated circuit reliability;Resilience;Cloud Native Applications;Microservice Patterns;Circuit Breaker;Fault Tolerance;Resilience},
  doi={10.1109/GCITC60406.2023.10426195},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10732944,
  author={Dong, Bo and Ying, Shi},
  booktitle={2024 IEEE 7th Information Technology, Networking, Electronic and Automation Control Conference (ITNEC)}, 
  title={A Deployment-Oriented Performance Modeling and Evaluation Method for SaaS Application Based on LQN}, 
  year={2024},
  volume={7},
  number={},
  pages={1665-1674},
  abstract={The deployment scheme of SaaS application has an important influence on the performance of SaaS application. Studying the impact of deployment scheme on the performance of SaaS application could contribute to performance improvement of application. However, there are few methods that can directly and efficiently model and analyze the relationship between deployment scheme and the performance of SaaS application. In this paper, a deployment-oriented method for modeling and evaluating the performance of SaaS application based on LQN is proposed. The performance modeling method can explicitly model both the SaaS application and the VM resources in multiple deployment schemes, and the performance metrics can be solved based on the model. The deployment-oriented performance evaluation method can evaluate the performance of services in SaaS application based on response time, which is used to further analyze the impact of the service-VM relationship and service-service relationship on the performance of services, and the analysis conclusions can provide useful help for adjusting the deployment scheme and improving the performance of SaaS application. Finally, some experiments are carried out to show the effectiveness of the proposed method and the analysis conclusions.},
  keywords={Performance evaluation;Analytical models;Automation;Time factors;Information technology;Optimization;Layered Queueing Networks;deployment scheme;performance modeling;performance evaluation;SaaS},
  doi={10.1109/ITNEC60942.2024.10732944},
  ISSN={2693-3128},
  month={Sep.},}@ARTICLE{8552654,
  author={Weinman, Joe},
  journal={IEEE Cloud Computing}, 
  title={Toward a Theoretical Model of Cloud Computing}, 
  year={2018},
  volume={5},
  number={6},
  pages={92-101},
  abstract={Cloud computing has proven to be extremely useful in practice.Both the cloud-service-provider industry and its business, scientific, and consumer applications have grown exponentially. However, there are also benefits to be gained from viewing cloud computing abstractly: understanding its fundamental behaviors, but also its limitations. After a five-year run, this is the last issue of IEEE Cloud Computing. However, it is to be hoped that this final article contains the seeds of some ideas that others will find interesting and productive, so as to continue research to formalize such a theory. In effect, this article lays the foundation for future research by encapsulating much of this columns last five years into a comprehensive, integrated theoretical framework.},
  keywords={Cloud computing;Behavioral sciences;Computer applications;Market research;Platform as a service;cloud computing;theory;theoretical model;behaviors},
  doi={10.1109/MCC.2018.064181124},
  ISSN={2325-6095},
  month={Nov},}@INPROCEEDINGS{10664232,
  author={Gu, Rong and Seceleanu, Tiberiu and Xiong, Ning and Naeem, Muhammad},
  booktitle={2024 IEEE International Conference on Software Services Engineering (SSE)}, 
  title={A Service-Oriented Digital Twin Framework for Dynamic and Robust Distributed Systems}, 
  year={2024},
  volume={},
  number={},
  pages={66-73},
  abstract={Digital Twins (DTs) are virtual representations of physical products in many dimensions, such as geometry and behaviour. As a backbone of Industry 4.0, DTs help interpret and even predict the behaviour of physical processes, provide a virtual testbed for maintenance and upgrade, and enable automatic decision-making supported by artificial intelligence. Despite the promising future, challenges exist, such as the absence of a framework that facilitates the development and application of DTs in industrial contexts. We propose a service-oriented architecture (SOA) DT framework for dynamic and robust distributed systems. The framework contains two types of services. One includes the services provided to the users and is supported by an orchestration mechanism to ensure a quality of service (QoS). The other one refers to the common functions of all DTs. Further, we describe the DT-based decision-making enabled by our QoS-oriented learning of the framework and a Hoare-logic-based verification of QoS.},
  keywords={Geometry;Decision making;Quality of service;Software;Service-oriented architecture;Digital twins;Maintenance;Digital Twins;SOA;System design;Machine learning;Formal verification},
  doi={10.1109/SSE62657.2024.00021},
  ISSN={},
  month={July},}@INPROCEEDINGS{9637894,
  author={Poudel, Shiva and Black, Gary D. and Reiman, Andrew P.},
  booktitle={2021 IEEE Power & Energy Society General Meeting (PESGM)}, 
  title={An Application for Validation of Power Distribution System Models in an ADMS Environment}, 
  year={2021},
  volume={},
  number={},
  pages={01-05},
  abstract={An accurate model of a power distribution system is the foundation for model-based algorithms that ensure efficient and reliable grid operation in an advanced distribution management system (ADMS) environment. However, distribution system models are error-prone and comprehensive model validation is challenging due to: (1) lack of standard information models, (2) multiple and overlapping sources of model data, and (3) the dynamic and evolving nature of the real-world systems that models are derived from. In this paper, a framework for comprehensive validation of networked equipment models is described. The framework ensures both consistency between equipment parameters and feasibility of a model to represent observed data. A software application that implements the validation framework is under development. The application has been pre-released within GridAPPS-D, an open-source standards-based platform for ADMS application development and demonstrated on the IEEE 13-bus, 123-bus, and 8500-node test feeders.},
  keywords={Measurement;Codes;Heuristic algorithms;Power distribution;Computer architecture;Data models;Reliability;Common information model;model checking;network topology;power distribution;power system modeling;system validation},
  doi={10.1109/PESGM46819.2021.9637894},
  ISSN={1944-9933},
  month={July},}@INPROCEEDINGS{9515055,
  author={Minea, Marius and Dumitrescu, Cătălin Marian and Minea, Viviana Laetitia and Semenescu, Augustin},
  booktitle={2021 13th International Conference on Electronics, Computers and Artificial Intelligence (ECAI)}, 
  title={Designing Intelligent Agents for the Management of Complex Data Communication Networks in Smart Cities}, 
  year={2021},
  volume={},
  number={},
  pages={1-6},
  abstract={The paper focuses on the design of future complex networks, in the perspective of smart cities, where many sensors and data flows are expected to arise. The research proposes the use of multiple intelligent agents to monitor critical features of the communication network, including hardware and applications/software components, in a tree architecture, with a top-supervisor agent, also used as human-machine interface for the Fault Management System operators. A study case is also included, along with recommendations for the best artificial intelligence components to be used in such an architecture.},
  keywords={Frequency modulation;Smart cities;Complex networks;Computer architecture;Communication networks;Mathematical model;Intelligent agents;AI agent;infrastructure monitoring;applications and microservices;automation;AI assistance},
  doi={10.1109/ECAI52376.2021.9515055},
  ISSN={},
  month={July},}@INPROCEEDINGS{11571481,
  author={Liu, Shuwen and Chalkiadakis, George and Polyzos, George C.},
  booktitle={IEEE INFOCOM 2026 - IEEE Conference on Computer Communications}, 
  title={MAMA-V: A Verifiable Distributed Multi-Agent Model AI Framework for Secure Orchestration}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Open distributed multi-agent systems, particularly those orchestrating Cloud microservices or edge computing resources, often run in adversarial settings. Most trust mechanisms either depend on a central authority (creating a single failure point) or only make logs immutable without guaranteeing agent honesty. This gap lets a malicious agent boost its reputation by selective reporting or collusion, which break reliable collaboration and routing. At the same time, agent orchestration and routing still lack a practical security layer that is both efficient and easy to deploy. We present Verifiable Multi-Agent Model AI (MAMA-V), a secure orchestration framework designed for decentralized integrity. MAMA-V records each key interaction as a signed, hash-linked Chain-of-Trust Credential (CoTC), so agents cannot deny their past actions. It then uses a lightweight Sparse Merkle Tree Trust Gateway (SMT-TG) to prove completeness of the reported history, so agents cannot hide failures. Based on this, MAMA-V develops a dynamic, contextual trust model that shifts trust from a static score to an intrinsic property that actively regulates system behavior. In an adversarial car insurance claims simulation, MAMA-V is more robust against strategic manipulation than current trustless dynamic orchestration baselines. In mixed adversarial environments, MAMA-V reduces the malicious pass rate from 40.3% (baseline) to 25.9%.},
  keywords={Modeling;Equations;Recording;History;Multi-agent systems;Printing;Tagging;Aluminum;Uncertainty;Protocols;Distributed Multi-Agent System;Verifiable Trust;Dynamic Orchestration},
  doi={10.1109/INFOCOM59046.2026.11571481},
  ISSN={2641-9874},
  month={May},}@ARTICLE{10347188,
  author={Fé, Iure and Nguyen, Tuan Anh and Soares, Andréc. B. and Son, Seokho and Choi, Eunmi and Min, Dugki and Lee, Jae-Woo and Silva, Francisco Airton},
  journal={IEEE Access}, 
  title={Model-Driven Dependability and Power Consumption Quantification of Kubernetes-Based Cloud-Fog Continuum}, 
  year={2023},
  volume={11},
  number={},
  pages={140826-140852},
  abstract={System dependability is pivotal for the reliable execution of designated computing functions. With the emergence of cloud-fog computing and microservices architectures, new challenges and opportunities arise in evaluating system dependability. Enhancing dependability in microservices often involves component replication, potentially increasing energy costs. Thus, discerning optimal redundancy strategies and understanding their energy implications is crucial for both cost efficiency and ecological sustainability. This paper presents a model-driven approach to evaluate the dependability and energy consumption of cloud-fog systems, utilizing Kubernetes, a container application orchestration platform. The developed model considers various determinants affecting system dependability, including hardware and software reliability, resource accessibility, and support personnel availability. Empirical studies validate the model’s effectiveness, demonstrating a 22.33% increase in system availability with only a 1.33% rise in energy consumption. Moreover, this methodology provides a structured framework for understanding cloud-fog system dependability, serves as a reference for comparing dependability across different systems, and aids in resource allocation optimization. This research significantly contributes to the efforts to enhance cloud-fog system dependability.},
  keywords={Modeling;Stochastic processes;Power demand;Energy consumption;Edge computing;Cloud computing;Cloud-fog continuum;dependability;Kubernetes;stochastic modeling},
  doi={10.1109/ACCESS.2023.3340195},
  ISSN={2169-3536},
  month={},}@ARTICLE{10443611,
  author={Simić, Miloš and Dedeić, Jovana and Stojkov, Milan and Prokić, Ivan},
  journal={IEEE Access}, 
  title={A Hierarchical Namespace Approach for Multi-Tenancy in Distributed Clouds}, 
  year={2024},
  volume={12},
  number={},
  pages={32597-32617},
  abstract={The micro cloud model offers cloud behavior at the edge of the network. It allows dynamic organization of the resources, closer to the users and the data. One of the crucial problems to solve is to design a proper cloud model at the edge of the network and offer cloud services that support multi-tenancy. This cloud property is a governing mechanism to lower cloud costs. It is essential for the scalability of both public and private clouds due to the utilization of shared resources and the logical separation of tenants. This paper presents the model for the creation of virtual clouds (vClouds) on physical infrastructure using a hierarchy of namespaces, with proper organization and redistribution of resources such as CPU, RAM, and storage, while preserving logical isolation between vClouds, thus creating a multi-tenant system. The presented model guarantees accurate resource redistribution through graph transformations to model operations, while the proposed protocols ensure correctness by employing multiparty session types for modeling. We extend the secure computing mode to establish an isolated system, allowing sandboxing rules for every namespace and creating hierarchies of security profiles. This advancement enables our model to inherit parent security profiles fully, extend them by adding child-specific elements, or redefine and create entirely new ones. Furthermore, the users can switch context, meaning they can change vCloud or the namespace they operate on.},
  keywords={Cloud computing;Protocols;Resource management;Computational modeling;Organizations;Switches;Costs;Distributed management;Formal specifications;Edge computing;Cloud computing;distributed systems;edge computing;formal specifications;infrastructure as software;platform;namespaces;isolation;multi-tenancy},
  doi={10.1109/ACCESS.2024.3369031},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11324626,
  author={Tong, Yiwei and Huang, Xin and Wang, Weineng and Gao, Bingqiang and Guo, Chunlan},
  booktitle={2025 7th International Conference on Frontier Technologies of Information and Computer (ICFTIC)}, 
  title={Top Design of Digitalization Specialty in a Power Company Based on TOGAF Framework}, 
  year={2025},
  volume={},
  number={},
  pages={1087-1090},
  abstract={Enterprise architecture framework has become the key computing infrastructure of digital transformation, which provides systematic abstraction mechanism and automatic coordination ability. This paper introduces a rigorous method to design digital enterprise architecture based on TOGAF framework, with emphasis on algorithm efficiency, distributed computing paradigm and formal modeling technology. The implementation includes service-oriented architecture (SOA) with micro-service decomposition, event-driven message queue with Apache Kafka (50 partitions, replication factor 3), and container arrangement with horizontal automatic expansion function through Kubernetes. The digital architecture integrates real-time ETL pipeline with O(n log n) complexity, distributed storage system and multi-layer caching strategy using Redis cluster. The technical infrastructure has deployed a hybrid cloud architecture that combines private cloud security with public cloud resilience, while API Gateway (Kong 3.0) uses token bucket algorithm to achieve a rate limit of 10,000 requests per second. Through database index (B+ trees), connection pool (HikariCP) and asynchronous processing (Celery with MQ), the performance has been optimized, and the average API response time has been reduced from 850 milliseconds to 120 milliseconds (a decrease of 85.9%), the system throughput has increased from 1,200 transactions per second to 8,500 transactions (an increase of 608%), and the overall system availability has reached 99. The architecture adopts circuit breaker mode, distributed tracking (Jaeger), service grid (Istio) and canary deployment strategy with automatic rollback mechanism. The paired t test (p < 0.001) was used for statistical verification, and it was confirmed that all 42 evaluation business processes were significantly optimized. This computing framework based on TOGAF shows how systematic application of computer science principles, including algorithm design, data structure optimization and distributed system theory, can promote the digital transformation of power industry.},
  keywords={Systematics;Digital transformation;Design methodology;Computational modeling;Trees (botanical);Computer architecture;Companies;Power industry;Service-oriented architecture;Power systems;TOGAF;Enterprise architecture;Top design;Business structure;Architecture governance},
  doi={10.1109/ICFTIC68075.2025.11324626},
  ISSN={},
  month={Dec},}@ARTICLE{8242669,
  author={Sebastio, Stefano and Ghosh, Rahul and Mukherjee, Tridib},
  journal={IEEE Transactions on Services Computing}, 
  title={An Availability Analysis Approach for Deployment Configurations of Containers}, 
  year={2021},
  volume={14},
  number={1},
  pages={16-29},
  abstract={Operating system (OS) containers enabling the microservice-oriented architecture are becoming popular in the context of Cloud services. Containers provide the ability to create lightweight and portable runtime environments that decouple the application requirements from the characteristics of the underlying system. Services built on containers have a small resource footprint in terms of processing, storage, memory and network, allowing a more dense deployment environment. While the performance of such containers is addressed in few previous studies, understanding the failure-repair behavior of the containers remains unexplored. In this paper, from an availability point of view, we propose and compare different configuration models for deploying a containerized software system. Inspired by Google Kubernetes, a container management system, these configurations are characterized with a failure response and migration service. We develop novel non-state-space (i.e., fault tree) and state-space (i.e., stochastic reward net) analytic models for container availability analysis. Analytical as well as simulative solutions are obtained for the developed models. Our analysis provides insights on k out-of N availability and sensitivity of system availability for key system parameters. Finally, we build an open-source software tool powered by these models. The tool helps a Cloud administrator to assess the availability of a containerized system and to conduct a what-if analysis based on user-provided parameters and configurations.},
  keywords={Containers;Analytical models;Cloud computing;Stochastic processes;Tools;Computer architecture;Google;Container;system availability;virtual machine;cloud computing;analytic model;stochastic reward net},
  doi={10.1109/TSC.2017.2788442},
  ISSN={1939-1374},
  month={Jan},}


