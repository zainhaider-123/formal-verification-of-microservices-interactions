@article{STUTZ20208268,
title = {Orchestration vs. Choreography Functional Association for Future Automation Systems},
journal = {IFAC-PapersOnLine},
volume = {53},
number = {2},
pages = {8268-8275},
year = {2020},
note = {21st IFAC World Congress},
issn = {2405-8963},
doi = {https://doi.org/10.1016/j.ifacol.2020.12.1961},
url = {https://www.sciencedirect.com/science/article/pii/S2405896320325891},
author = {Andreas Stutz and Alexander Fay and Mike Barth and Mathias Maurmaier},
keywords = {service-oriented automation architecture, decentralized automation, service orchestration, service choreography, service composition, service aggregation, service association},
abstract = {Production flexibility, engineering efficiency and faster time-to-market are customer needs in order to survive on the market. Highly flexible system architectures are the key to fulfill these needs. Today’s procedural flexibility, like in the IEC 61512 standard, is not sufficient. Extending flexibility is a must, whereas central orchestration systems reach their limits. Besides orchestration there is a second association method, the choreography. The focus of this contribution is the question of how choreography can be applied in the automation context. Starting point of this contribution is a terminology foundation in the domain of micro-service automation systems followed by a characterization of orchestration and choreography in the automation context. In this paper, we show that both methods complement each other ideally. Central orchestration is used to coordinate decentralized choreographies - complexity reduction combined with high flexibility.}
}
@article{CALABRO2025101557,
title = {CONCERN: A model-based monitoring infrastructure},
journal = {Internet of Things},
volume = {31},
pages = {101557},
year = {2025},
issn = {2542-6605},
doi = {https://doi.org/10.1016/j.iot.2025.101557},
url = {https://www.sciencedirect.com/science/article/pii/S2542660525000708},
author = {Antonello Calabrò and Eda Marchetti and Paweł Skrzypek and Jan Marchel},
keywords = {Monitoring, System engineering, Anomaly detection, Predictive maintenance},
abstract = {Characteristics such as quality, trustworthiness, and cybersecurity are becoming essential in the ecosystems of Internet of Things (IoT) systems. Although significant efforts in industry and academia have been made to create solutions that ensure, monitor, and evaluate these attributes throughout the development process, time-to-market urgency, demands for higher productivity, and competitive pressures often result in faster release schedules. This situation calls for methods and means to quickly and accurately identify and avert anomalies and hazardous circumstances. Among them, a monitoring system is an effective solution for evaluating functional and non-functional attributes during the online execution. This paper proposes an integrated Runtime Monitoring solution called CONCERN (COmplex eveNt proCEssing monitoR iNfrastructure) for guaranteeing a consistent quality of services, managing the possible execution exceptions and interruptions, and providing a high system availability. The paper describes the CONCERN supporting architecture and proof-of-concept implementation of its components, validation of the CONCERN usability, and its performance in a real scenario taken from the financial domain. Finally, the paper reports the discussion, lessons learned, and the future work suggested by the showcase.}
}
@article{NOOR2025100276,
title = {Kubernetes application performance benchmarking on heterogeneous CPU architecture: An experimental review},
journal = {High-Confidence Computing},
volume = {5},
number = {1},
pages = {100276},
year = {2025},
issn = {2667-2952},
doi = {https://doi.org/10.1016/j.hcc.2024.100276},
url = {https://www.sciencedirect.com/science/article/pii/S2667295224000795},
author = {Jannatun Noor and MD Badsha Faysal and MD Sheikh Amin and Bushra Tabassum and Tamim Raiyan Khan and Tanvir Rahman},
keywords = {Kubernetes, K8s, K3s, Serverless computing, Container as a Service (CaaS), Container orchestration, Docker, CPU architecture, x86, ARM},
abstract = {With the rapid advancement of cloud technologies, cloud services have enormously contributed to the cloud community for application development life-cycle. In this context, Kubernetes has played a pivotal role as a cloud computing tool, enabling developers to adopt efficient and automated deployment strategies. Using Kubernetes as an orchestration tool and a cloud computing system as a manager of the infrastructures, developers can boost the development and deployment process. With cloud providers such as GCP, AWS, Azure, and Oracle offering Kubernetes services, the availability of both x86 and ARM platforms has become evident. However, while x86 currently dominates the market, ARM-based solutions have seen limited adoption, with only a few individuals actively working on ARM deployments. This study explores the efficiency and cost-effectiveness of implementing Kubernetes on different CPU platforms. By comparing the performance of x86 and ARM platforms, this research seeks to ascertain whether transitioning to ARM presents a more advantageous option for Kubernetes deployments. Through a comprehensive evaluation of scalability, cost, and overall performance, this study aims to shed light on the viability of leveraging ARM on different CPUs by providing valuable insights.}
}
@article{HASHMI2025126118,
title = {Proactive self-exploration: Leveraging information sharing and predictive modelling for anticipating and countering adversaries},
journal = {Expert Systems with Applications},
volume = {267},
pages = {126118},
year = {2025},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2024.126118},
url = {https://www.sciencedirect.com/science/article/pii/S0957417424029853},
author = {Saad Sajid Hashmi and Hoa Khanh Dam and Mohan {Baruwal Chhetri} and Anton V. Uzunov and Alan Colman and Quoc Bao Vo},
keywords = {Behavioural model, Predictive model, Information sharing, Adversarial search},
abstract = {In contested environments, self-exploration is a self-* property that serves as a proactive mechanism for countering threats posed by adversaries. Specifically, self-exploration leverages adversarial search to anticipate the effects of potential adversary-initiated actions that may undermine an agent or system’s own goals, and to assess counter-measures to pursue those goals. However, a significant limitation of adversarial search is the exponentially growing search space, which poses a challenge to its practicality. To address this problem, we propose a framework for proactive self-exploration that combines two key components: (i) the identification and sharing of pertinent information among multiple agents, and (ii) predictive modelling of the potential effects of adversaries’ actions on goals, to anticipate and effectively counter adversarial efforts. Through information sharing, the framework leverages the collective knowledge of distributed agents to address the challenge of incomplete information. Predictive modelling helps narrow down the exploration options during adversarial search, effectively reducing the search space. We perform evaluations to assess the effectiveness and efficiency of our proposed approach, thus ensuring its practical viability and demonstrating its potential in countering adversaries.}
}
@article{ZHANG2025487,
title = {A low-code modular CAD system oriented towards machining features for STEP-NC compliant manufacturing},
journal = {Journal of Manufacturing Systems},
volume = {80},
pages = {487-502},
year = {2025},
issn = {0278-6125},
doi = {https://doi.org/10.1016/j.jmsy.2025.03.010},
url = {https://www.sciencedirect.com/science/article/pii/S027861252500072X},
author = {Kaiyao Zhang and Wenlei Xiao and Xiangming Fan and Gang Zhao},
keywords = {STEP-NC, Low-code, Machining feature, CAD, CNC machining},
abstract = {The next-generation STEP-NC technology requires automatic generation of machining strategies within manufacturing systems to implement flexible manufacturing in the future. Currently, the machining feature modeling based on STEP-NC is in its infancy, facing challenges such as cumbersome modeling processes, ineffective utilization of the STEP-NC standard, and low development efficiency. A low-code modular solution based on the STEP-NC data kernel for machining feature-oriented modeling is important to achieve more intelligent flexible manufacturing. This paper presents a low-code modular modeling method for machining features, based on the STEP-NC data structure and incorporating geometric, process, and machining information, aimed at part milling. A low-code modular CAD modeling platform based on STEP-NC was built using Rhino Grasshopper. Additionally, a toolpath generation algorithm was designed for milling feature models to enable the automatic generation of milling strategies. Finally, the feasibility of a low-code modular CAD system based on machining features for STEP-NC compliant manufacturing in engineering applications is validated through a case study involving part design, milling, and optimization.}
}
@article{THEVINH2026101424,
title = {Policy-aware interface contracts for testing access-control and selected privacy obligations in service APIs},
journal = {Journal of Computer Languages},
volume = {89},
pages = {101424},
year = {2026},
issn = {2590-1184},
doi = {https://doi.org/10.1016/j.cola.2026.101424},
url = {https://www.sciencedirect.com/science/article/pii/S2590118426000407},
author = {Nguyen The-Vinh},
keywords = {API contract testing, Domain-specific languages, Language-based security, Software specification, Software verification},
abstract = {An API response can match its schema while exposing another user’s data or failing to record a required audit event. This paper defines a compact policy-contract profile for testing access-control and selected privacy obligations in service APIs. The profile embeds required fields and optional dependent clauses in OpenAPI, relates them to authorization and privacy standards, and organizes coverage into four cumulative profiles. A compiler turns each declared obligation into a test case and a check of the relevant response, state change, audit event, or endpoint lifecycle behavior. In a controlled synthetic benchmark based on 12 policy templates, the generated checks detect the same injected faults as separately implemented handwritten assertions. The generated suite produces no false alerts on 5520 compliant evidence variations. Executions on VAmPI and OWASP crAPI detect seven documented defects without alerts on five controls. These results support the feasibility of generating traceable policy tests from interface contracts. The assurance remains limited to the obligations recorded in the contract and the evidence available to check them.}
}
