@CONFERENCE{Argakoesoemah2024102,
	author = {Argakoesoemah, Mohamad Daffa and Candra, Muhammad Zuhri Catur},
	title = {Development of Cascading Circuit Breaker System using Event-Driven Approach in Microservices},
	year = {2024},
	journal = {Proceedings of 2024 IEEE International Conference on Data and Software Engineering: Data-Driven Innovation: Transforming Industries and Societies, ICoDSE 2024},
	pages = {102 - 107},
	doi = {10.1109/ICODSE63307.2024.10829897},
	url = {https://www.scopus.com/pages/publications/85217578363?origin=resultslist},
	abstract = {Resilience, particularly in handling service failures, is a significant challenge in microservices. This can be addressed using circuit breakers to limit calls to failed services. However, changes in the state of circuit breakers are only known by directly connected services, allowing subsequent services in the chain to continue making calls. One study addresses this issue by creating a cascading circuit breaker system to prevent premature calls to failed services. Nevertheless, this system has limitations, such as the inability to inform newly deployed services and services that are independent of the service aware of the state change. Moreover, there are research opportunities to improve how circuit breakers operate. To address these problems, this paper proposes an event-driven cascading circuit breaker system. An event-driven approach offers greater flexibility compared to the request-response style used in existing cascading circuit breakers. Additionally, improvements include a mechanism to redirect calls to an alternative endpoint if the original endpoint is in an open state. The testing results demonstrate that the proposed system effectively resolves the issues present in existing cascading circuit breakers. Furthermore, the system successfully redirects calls to an alternative endpoint if the primary endpoint is open. The average system overhead is quite low, at 2.86 milliseconds. The time taken for state changes to be received by all necessary services is 2.12 minutes. © 2024 IEEE.},
	author_keywords = {circuit breaker; event-driven; microservices},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

