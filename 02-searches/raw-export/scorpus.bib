@ARTICLE{Abinaya2027,
	author = {Abinaya, J. and Thilagam, P.Santhi and Sivakumar, K. and Pais, Alwyn Roshan},
	title = {Security testing of RESTful APIs: Approaches and research challenges},
	year = {2027},
	journal = {Computer Science Review},
	volume = {63},
	pages = {},
	doi = {10.1016/j.cosrev.2026.101043},
	url = {https://www.scopus.com/pages/publications/105046395951?origin=resultslist},
	abstract = {RESTful APIs have become a fundamental component of modern cloud-native and microservice-based applications, enabling seamless integration between distributed services. Since these APIs often expose sensitive data and business logic through publicly accessible endpoints, they have become attractive targets for cyberattacks. Recent security incidents and the growing number of API-related vulnerabilities demonstrate that traditional web application security mechanisms are insufficient for protecting RESTful APIs. Although numerous testing approaches have been proposed, existing research remains fragmented and often focuses primarily on functional validation rather than systematically addressing security vulnerabilities and adversarial exploitation patterns. This survey provides a comprehensive review of RESTful API testing approaches with a particular focus on those identifying security vulnerabilities. Based on a systematic analysis of 69 primary studies, we examine common RESTful API vulnerabilities and present a structured taxonomy that distinguishes between application-level weaknesses and configuration or deployment-level issues. We further analyze the attack patterns that exploit these vulnerabilities and review state-of-the-art testing approaches, including specification-based, model-based, property-based, and AI/ML-driven techniques. In addition, we analyze existing tools, datasets, and evaluation metrics used to assess the effectiveness of RESTful API testing methods. Finally, the survey identifies several critical research gaps that limit the effectiveness of current approaches, particularly around authenticated, context-aware testing and the detection and validation of logic-based security violations. We discuss emerging trends and outline potential research directions, including dependency-aware testing frameworks and AI-driven techniques for automated vulnerability discovery. This work aims to guide researchers and practitioners toward developing more systematic and robust frameworks for RESTful API security testing. © 2026 Elsevier Inc.},
	author_keywords = {Attacks; Dependency modeling; OpenAPI specification; RESTful APIs; Test case generation; Vulnerabilities},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Bronze Open Access}
}

@CONFERENCE{Elrashidy2025382,
	author = {Elrashidy, Mahmoud Raafat and Mansour, Hesham},
	title = {Microservices Architecture in Fintech: A Case Study on Scalable Loan Processing with Classical Design Patterns},
	year = {2025},
	journal = {3rd International Conference on Intelligent Methods, Systems and Applications, IMSA 2025},
	pages = {382 - 387},
	doi = {10.1109/IMSA65733.2025.11167186},
	url = {https://www.scopus.com/pages/publications/105018475063?origin=resultslist},
	abstract = {Digital transformation in financial services, fueled by real-time payments, buy-now-pay-later (BNPL) offerings, and open banking APIs, intensifies the imperative for credit platforms to achieve rapid and secure feature releases while adhering to stringent regulatory demands. However, empirical evidence detailing the adoption of microservices within regulated fintech remains limited. This paper presents an in-depth single-organization case study of a medium-sized consumer finance lender that migrated its monolithic Node/Spring architecture to domain-driven microservices between Q4 2023 and Q3 2024. Employing a mixed-methods approach - analyzing Application Performance Monitoring (APM) traces, Git/GitHub workflow metrics, and conducting 12 semi-structured interviews with engineers - we evaluated the migration outcomes and the strategic application of four classical design patterns: Factory, Observer, Repository, and Saga. Key findings reveal significant improvements: median deployment lead time decreased by 85% (from 3 days to 45 minutes), 95th percentile API latency reduced by 77% (from 480 ms to 110 ms), and throughput capacity increased 4.3-fold to 10,000 requests per second. The Factory pattern eliminated 40% of decision-tree branching, the Observer pattern enabled a 5× horizontal fan-out for parallel processing, while the Repository pattern introduced a manageable 7 ms latency overhead, cacheable in 92% of calls. The study highlights a crucial trade-off between a ≈30% increase in operational observability costs and the enhanced agility required for near real-time regulatory adjustments. Ultimately, this research provides a pattern-centric blueprint for similar migrations and identifies key areas for future investigation, including zero-trust service meshes, AI-driven credit scoring, and formal verification of cross-service sagas.  © 2025 IEEE.},
	author_keywords = {Design Patterns; Fintech; Loan Processing; Microservices; Scalability},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

