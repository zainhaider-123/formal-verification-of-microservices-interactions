@CONFERENCE{Liu2026,
	author = {Liu, Shuwen and Chalkiadakis, George and Polyzos, George C.},
	title = {MAMA-V: A Verifiable Distributed Multi-Agent Model AI Framework for Secure Orchestration},
	year = {2026},
	journal = {Proceedings - IEEE INFOCOM},
	pages = {},
	doi = {10.1109/INFOCOM59046.2026.11571481},
	url = {https://www.scopus.com/pages/publications/105044562245?origin=resultslist},
	abstract = {Open distributed multi-agent systems, particularly those orchestrating Cloud microservices or edge computing resources, often run in adversarial settings. Most trust mechanisms either depend on a central authority (creating a single failure point) or only make logs immutable without guaranteeing agent honesty. This gap lets a malicious agent boost its reputation by selective reporting or collusion, which break reliable collaboration and routing. At the same time, agent orchestration and routing still lack a practical security layer that is both efficient and easy to deploy. We present Verifiable Multi-Agent Model AI (MAMA-V), a secure orchestration framework designed for decentralized integrity. MAMA-V records each key interaction as a signed, hash-linked Chain-of-Trust Credential (CoTC), so agents cannot deny their past actions. It then uses a lightweight Sparse Merkle Tree Trust Gateway (SMT-TG) to prove completeness of the reported history, so agents cannot hide failures. Based on this, MAMA-V develops a dynamic, contextual trust model that shifts trust from a static score to an intrinsic property that actively regulates system behavior. In an adversarial car insurance claims simulation, MAMA-V is more robust against strategic manipulation than current trustless dynamic orchestration baselines. In mixed adversarial environments, MAMA-V reduces the malicious pass rate from 40.3% (baseline) to 25.9%. © 2026 IEEE.},
	author_keywords = {Distributed Multi-Agent System; Dynamic Orchestration; Verifiable Trust},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

