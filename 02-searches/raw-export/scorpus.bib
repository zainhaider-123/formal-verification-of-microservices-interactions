@ARTICLE{Merkouche20263525,
	author = {Merkouche, Souheir and Bouanaka, Chafia and Benkhelifa, Elhadj and Guegan, Chirine Ghedira},
	title = {HARMONY: A Holistic Auto-Scaling Resilient Model for Multi-Objective Adaptation in Microservices Using HPPNs—A Case Study on E-Business Platforms},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {3525 - 3544},
	doi = {10.1109/ACCESS.2025.3649730},
	url = {https://www.scopus.com/pages/publications/105026402787?origin=resultslist},
	abstract = {Modern microservice architectures face significant auto-scaling challenges due to dynamic workloads, heterogeneous resource demands, and competing quality objectives like performance, cost, and reliability. Existing solutions often adopt either centralized (bottleneck-prone) or decentralized (conflict-prone) architectures, rely on single-metric threshold-based adaptations, and lack formal guarantees on system behavior. To address these limitations, we propose HARMONY, a holistic auto-scaling framework that ensures both hierarchical coordination, multi-objective adaptation, and formal verification for microservices. The layered MAPE-K architecture of HARMONY enables coordinated adaptation between individual microservices and the overall system through shared knowledge and distributed quality adaptation mechanisms. The Pareto-based planning strategy of HARMONY dynamically selects compromise scaling actions that balance system-wide objectives with microservice-level constraints. HARMONY formalizes adaptation behaviors using Hierarchical Parallel Petri Nets (HPPNs), enabling rigorous verification of deadlock freeness, boundedness, and correctness. We implement HARMONY through the ScopeNet framework and evaluate it through a realistic e-business case study. Results show that HARMONY: 1) autonomously coordinates cross-service adaptations, 2) optimizes trade-offs among conflicting objectives, and 3) ensures reliable behavior under diverse runtime conditions. These capabilities represent a significant improvement in the state of the art for scalable, verifiable, and adaptive microservice auto-scaling. © 2013 IEEE.},
	author_keywords = {auto-scaling; cloud computing; formal verification; Microservices; Petri nets},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

