@CONFERENCE{Weerasinghe2026157,
	author = {Weerasinghe, Shakthi},
	title = {A No-Code Composable Pipeline for Holistic Microservice Assurance},
	year = {2026},
	journal = {Proceedings - 2026 IEEE 23rd International Conference on Software Architecture Companion, ICSA-C 2026},
	pages = {157 - 162},
	doi = {10.1109/ICSA-C68850.2026.00041},
	url = {https://www.scopus.com/pages/publications/105048467016?origin=resultslist},
	abstract = {Modern cloud-native 'systems' are distributed abstractions scattered across independent repositories. While this multi-repository, loosely-coupled approach maximizes agility, it exposes a fundamental quality assurance gap: existing CI/CD tools are confined to single-repository contexts and linear procedural execution, leaving architects with no mechanism to reason about system-wide health. Thus, cross-service architectural drift and latent security violations go undetected by design. This paper introduces the Holistic Analysis Orchestrator (HAO), a novel framework that shifts the paradigm from linear pipelines to assurance graphs. HAO's 'no-code' visual wizard lets practitioners compose multi-repository verification strategies from disparate analysis engines-without scripting. We demonstrate a God's Eye workflow that ingests an entire distributed topology to concurrently perform Change Impact Analysis (CIMET), Formal Authorization Policy Consistency Verification (via SMT solvers), Neuro-Symbolic Latent Risk Assessment (Aegis), and Call-graphAware Test Suite Generation (AITest). The result is a feedbackdriven assurance fabric that unifies static analysis, formal logic, and generative validation-capabilities absent from any existing enterprise tooling.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang202134,
	author = {Wang, Jingzi and Mao, Hongyan and Jiang, Ningkang},
	title = {Formal Modeling and Verification of Microservice-Based Cyber-Physical System},
	year = {2021},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {12723 LNCS},
	pages = {34 - 53},
	doi = {10.1007/978-3-030-77474-5_3},
	url = {https://www.scopus.com/pages/publications/85111140610?origin=resultslist},
	abstract = {Cyber-Physical System (CPS) has attracted extensive attention in diverse application fields. However, the modeling and verification of CPS is a great challenge because of its complexity and the changing interactive environments. Hence, how to simplify the complicated system design, improve the flexibility and correctness is a concerned research issue. Therefore, we provide a microservice-based framework of CPS application, named MSBF. The MSBF uses a level structure to explicit the interface and communication, and adopts the microservice architecture to guarantee the flexibility. To prove the correctness and reliability of MSBF, the formal method Communication Sequential Processes (CSP) is adopted to model and verify the MSBF. A method is proposed for transforming the main component of MSBF to CSP. Moreover, a case study of smart museum system is given, which has several requirements to be satisfied. The system is built by MSBF, and transformed to CSP. The modeling of the system includes the modules and interactive communications, and that illustrates the feasibility and sustainability of the framework. The Process Analysis Toolkit (PAT) is used to verify the properties of the constructed model. The verification results show that the deadlock does not exist and the requirements are satisfied. © 2021, Springer Nature Switzerland AG.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

